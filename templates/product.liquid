{% comment %}
  The contents of the product.liquid template can be found in /sections/product-template.liquid
{% endcomment %}

{{ 'custom-trustshop-reviews.css' | asset_url | stylesheet_tag }}
<style>
  #trustshop-review {
    --trustshop-bronze-badge: url("{{ 'bronze.svg.svg' | asset_url }}");
  }
</style>

{% section 'product-template' %}
{% section 'custom-ingredient-benefits' %}
{% section 'custom-routine-tips' %}
{% section 'custom-comparison-table' %}
{% section 'custom-simple-steps' %}
{% section 'custom-real-results' %}
{% section 'product-recommendations' %}
{% section 'custom-switch-reviews' %}

{% if collection %}
  <div class="text-center return-link-wrapper page-width">
    <a href="{{ collection.url }}" class="btn btn--secondary btn--has-icon-before return-link">
      {% include 'icon-arrow-left' %}
      {{ 'products.product.back_to_collection' | t: title: collection.title }}
    </a>
  </div>
{% endif %}

<script>
  // Override default values of shop.strings for each template.
  // Alternate product templates can change values of
  // add to cart button, sold out, and unavailable states here.
  theme.productStrings = {
    addToCart: {{ 'products.product.add_to_cart' | t | json }},
    soldOut: {{ 'products.product.sold_out' | t | json }},
    unavailable: {{ 'products.product.unavailable' | t | json }}
  }
</script>

{% assign current_variant = product.selected_or_first_available_variant %}

<script type="application/ld+json">
{
  "@context": "http://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  {%- if product.featured_image -%}
    {%- assign image_size = product.featured_image.width | append: 'x' -%}
    "image": [
      {{ product.featured_image.src | img_url: image_size | prepend: "https:" | json }}
    ],
  {%- endif -%}
  "description": {{ product.description | strip_html | json }},
  {%- if current_variant.sku != blank -%}
    "sku": {{ current_variant.sku | json }},
  {%- endif -%}
  "brand": {
    "@type": "Thing",
    "name": {{ product.vendor | json }}
  },
  "offers": [
    {%- for variant in product.variants -%}
      {
        "@type" : "Offer",
        {%- if variant.sku != blank -%}
          "sku": {{ variant.sku | json }},
        {%- endif -%}
        "availability" : "http://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
        "price" : {{ variant.price | divided_by: 100.00 | json }},
        "priceCurrency" : {{ cart.currency.iso_code | json }},
        "url" : {{ shop.url | append: variant.url | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
<div class="trustshop trustshop-review-wrap trustshop-widget-box" id="trustshop-review" data-product-id="{{ product.id }}" data-main-tab="summary" data-review-to-display="all"></div>

{% section 'slimfair-awards-logo-bar' %}

<div id="SlimfairReviewAwardTemplate" hidden>
  <div class="slimfair-review-award-column">
    <img
      class="slimfair-review-award-column__badge"
      src="{{ 'bronze.svg.svg' | asset_url }}"
      alt="Bronze Transparency 85.7"
      loading="lazy"
      width="112"
      height="112">
    <a
      class="slimfair-review-award-column__verified"
      href="{{ settings.review_verified_link | default: '#trustshop-review' }}"
      aria-label="Verified reviews">
      <span>{{ settings.review_verified_label | default: 'Verified' }}</span>
      <img
        src="{{ 'verified-icon.svg' | asset_url }}"
        alt=""
        aria-hidden="true"
        loading="lazy"
        width="16"
        height="16">
    </a>
  </div>
</div>

<script>
  (function() {
    var reviewRoot = document.getElementById('trustshop-review');
    var template = document.getElementById('SlimfairReviewAwardTemplate');
    if (!reviewRoot || !template) return;

    function mountAwardColumn() {
      var overview = reviewRoot.querySelector('.trustshop-overview--wrap');
      if (!overview || overview.querySelector('.slimfair-review-award-column')) return;

      var award = template.firstElementChild.cloneNode(true);
      overview.appendChild(award);
    }

    function moveWriteReviewBelowList() {
      var writeReview = reviewRoot.querySelector('.trustshop-write-review');
      var reviewBody = reviewRoot.querySelector('.trustshop-review--body');
      if (!writeReview || !reviewBody || writeReview.parentNode === reviewBody) return;

      reviewBody.appendChild(writeReview);
    }

    function syncReviewLayout() {
      mountAwardColumn();
      moveWriteReviewBelowList();
    }

    syncReviewLayout();

    var observer = new MutationObserver(syncReviewLayout);
    observer.observe(reviewRoot, { childList: true, subtree: true });
  })();
</script>
