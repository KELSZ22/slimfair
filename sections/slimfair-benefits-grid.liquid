<section
  id="SlimfairBenefitsGrid-{{ section.id }}"
  class="sf-benefits-grid"
  style="
    --sf-benefits-background: {{ section.settings.background_color }};
    --sf-benefits-card-background: {{ section.settings.card_background }};
    --sf-benefits-card-border: {{ section.settings.card_border }};
    --sf-benefits-heading-color: {{ section.settings.heading_color }};
    --sf-benefits-text-color: {{ section.settings.text_color }};
    --sf-benefits-icon-color: {{ section.settings.icon_color }};
    --sf-benefits-gap: {{ section.settings.card_gap }}px;
    --sf-benefits-card-radius: {{ section.settings.card_border_radius }}px;
    --sf-benefits-icon-size: {{ section.settings.icon_size }}px;
    --sf-benefits-padding-top: {{ section.settings.padding_top }}px;
    --sf-benefits-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="sf-benefits-grid__container">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="sf-benefits-grid__header">
        {% if section.settings.heading != blank %}
          <h2 class="sf-benefits-grid__section-heading">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p class="sf-benefits-grid__section-description">
            {{ section.settings.description | escape }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="sf-benefits-grid__cards">
        {% for block in section.blocks %}
          <div class="sf-benefit-card" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank or block.settings.fallback_icon != blank %}
              <div class="sf-benefit-card__icon-wrapper">
                {% if block.settings.icon != blank %}
                  {{
                    block.settings.icon
                    | image_url: width: 160
                    | image_tag:
                      class: 'sf-benefit-card__icon',
                      widths: '40, 60, 80, 120, 160',
                      sizes: '48px',
                      loading: 'lazy',
                      alt: block.settings.heading
                  }}
                {% elsif block.settings.fallback_icon != blank %}
                  <span class="sf-benefit-card__fallback-icon" aria-hidden="true">
                    {{ block.settings.fallback_icon | escape }}
                  </span>
                {% endif %}
              </div>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h3 class="sf-benefit-card__heading">
                {{ block.settings.heading | escape }}
              </h3>
            {% endif %}

            {% if block.settings.description != blank %}
              <p class="sf-benefit-card__description">
                {{ block.settings.description | escape | newline_to_br }}
              </p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #SlimfairBenefitsGrid-{{ section.id }} {
    width: 100%;
    background-color: var(--sf-benefits-background);
    padding: var(--sf-benefits-padding-top) 40px var(--sf-benefits-padding-bottom);
  }

  #SlimfairBenefitsGrid-{{ section.id }} .sf-benefits-grid__container {
    width: 100%;
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
  }

  #SlimfairBenefitsGrid-{{ section.id }} .sf-benefits-grid__header {
    max-width: 820px;
    margin: 0 auto {{ section.settings.header_spacing }}px;
    text-align: center;
  }

  #SlimfairBenefitsGrid-{{ section.id }} .sf-benefits-grid__section-heading {
    margin: 0;
    color: var(--sf-benefits-heading-color, #5C3F2D);
    text-align: center;
    font-family: Lora, Georgia, serif;
    font-size: 32px;
    font-style: normal;
    font-weight: 700;
    line-height: 1.25;
  }

  #SlimfairBenefitsGrid-{{ section.id }} .sf-benefits-grid__section-description {
    margin: 10px 0 0;
    color: var(--sf-benefits-text-color, #5C3F2D);
    text-align: center;
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.6;
  }

  #SlimfairBenefitsGrid-{{ section.id }} .sf-benefits-grid__cards {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: var(--sf-benefits-gap);
  }

  #SlimfairBenefitsGrid-{{ section.id }} .sf-benefit-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: {{ section.settings.card_min_height }}px;
    padding: {{ section.settings.card_padding_top }}px 22px {{ section.settings.card_padding_bottom }}px;
    border: 1px solid var(--sf-benefits-card-border);
    border-radius: var(--sf-benefits-card-radius);
    background-color: var(--sf-benefits-card-background);
    text-align: center;
  }

  #SlimfairBenefitsGrid-{{ section.id }} .sf-benefit-card__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--sf-benefits-icon-size);
    height: var(--sf-benefits-icon-size);
    margin: 0 auto 13px;
    color: var(--sf-benefits-icon-color);
  }

  #SlimfairBenefitsGrid-{{ section.id }} .sf-benefit-card__icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #SlimfairBenefitsGrid-{{ section.id }} .sf-benefit-card__fallback-icon {
    color: var(--sf-benefits-icon-color);
    font-family: Lora, Georgia, serif;
    font-size: 38px;
    font-weight: 700;
    line-height: 1;
  }

  #SlimfairBenefitsGrid-{{ section.id }} .sf-benefit-card__heading {
    margin: 0 0 6px;
    color: var(--sf-benefits-heading-color, #5C3F2D);
    text-align: center;
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 700;
    line-height: 1.35;
  }

  #SlimfairBenefitsGrid-{{ section.id }} .sf-benefit-card__description {
    max-width: 270px;
    margin: 0;
    color: var(--sf-benefits-text-color, #5C3F2D);
    text-align: center;
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.55;
  }

  @media screen and (max-width: 1199px) {
    #SlimfairBenefitsGrid-{{ section.id }} {
      padding-right: 28px;
      padding-left: 28px;
    }

    #SlimfairBenefitsGrid-{{ section.id }} .sf-benefits-grid__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #SlimfairBenefitsGrid-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-right: 15px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      padding-left: 15px;
    }

    #SlimfairBenefitsGrid-{{ section.id }} .sf-benefits-grid__header {
      margin-bottom: 28px;
    }

    #SlimfairBenefitsGrid-{{ section.id }} .sf-benefits-grid__section-heading {
      font-size: 27px;
      line-height: 1.3;
    }

    #SlimfairBenefitsGrid-{{ section.id }} .sf-benefits-grid__section-description {
      font-size: 14px;
      line-height: 1.55;
    }

    #SlimfairBenefitsGrid-{{ section.id }} .sf-benefits-grid__cards {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 14px;
    }

    #SlimfairBenefitsGrid-{{ section.id }} .sf-benefit-card {
      min-height: auto;
      padding: 24px 16px 22px;
    }

    #SlimfairBenefitsGrid-{{ section.id }} .sf-benefit-card__icon-wrapper {
      margin-bottom: 11px;
    }

    #SlimfairBenefitsGrid-{{ section.id }} .sf-benefit-card__heading {
      font-size: 17px;
    }

    #SlimfairBenefitsGrid-{{ section.id }} .sf-benefit-card__description {
      font-size: 13px;
      line-height: 1.5;
    }
  }

  @media screen and (max-width: 479px) {
    #SlimfairBenefitsGrid-{{ section.id }} .sf-benefits-grid__cards {
      {% if section.settings.columns_mobile == '2' %}
        grid-template-columns: repeat(2, minmax(0, 1fr));
      {% else %}
        grid-template-columns: 1fr;
      {% endif %}
    }
  }
</style>

{% schema %}
{
  "name": "Slimfair benefits grid",
  "tag": "section",
  "class": "section-slimfair-benefits-grid",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Optional section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to show cards only, like the reference image."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "info": "Leave blank to show cards only, like the reference image."
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Spacing below heading",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Section colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F7FBEA"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#F7FBEA"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#E4C876"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#5C3F2D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#5C3F2D"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Fallback icon color",
      "default": "#5C3F2D"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container maximum width",
      "min": 900,
      "max": 1500,
      "step": 10,
      "unit": "px",
      "default": 1290
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Cards per row on desktop",
      "default": "4",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "card_min_height",
      "label": "Card minimum height",
      "min": 130,
      "max": 280,
      "step": 2,
      "unit": "px",
      "default": 178
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_padding_top",
      "label": "Card padding top",
      "min": 12,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "card_padding_bottom",
      "label": "Card padding bottom",
      "min": 12,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 28,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop padding top",
      "min": 10,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop padding bottom",
      "min": 10,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Cards per row on mobile",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image",
          "info": "Upload a brown transparent PNG or SVG icon."
        },
        {
          "type": "text",
          "id": "fallback_icon",
          "label": "Fallback icon",
          "info": "Used only when no image is uploaded."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Faster Metabolism"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Formulated with L-Carnitine and Green Coffee to kickstart your body's natural ability to manage weight."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slimfair benefits grid",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "fallback_icon": "♨",
            "heading": "Faster Metabolism",
            "description": "Formulated with L-Carnitine and Green Coffee to kickstart your body's natural ability to manage weight."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "fallback_icon": "✦",
            "heading": "Reduced Bloating",
            "description": "Our Prebiotic Fiber supports a flatter stomach and smoother digestion without the harsh laxative effects."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "fallback_icon": "♨",
            "heading": "Less Cravings",
            "description": "MCT Oil provides fuel for your brain and body, helping you stay energized through a busy schedule without those cravings."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "fallback_icon": "✧",
            "heading": "Glowing Radiant Skin",
            "description": "Premium Collagen and Glutathione work from within to support glowing skin, healthier hair, and a youthful appearance."
          }
        }
      ]
    }
  ]
}
{% endschema %}