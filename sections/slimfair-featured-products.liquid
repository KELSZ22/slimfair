{% liquid
  assign section_heading = section.settings.heading
  assign section_description = section.settings.description
%}

<section
  id="SlimfairFeaturedProducts-{{ section.id }}"
  class="sf-featured-products"
  style="
    --sf-section-background: {{ section.settings.background_color }};
    --sf-heading-color: {{ section.settings.heading_color }};
    --sf-text-color: {{ section.settings.text_color }};
    --sf-accent-color: {{ section.settings.accent_color }};
    --sf-button-background: {{ section.settings.button_background }};
    --sf-button-text: {{ section.settings.button_text }};
    --sf-badge-background: {{ section.settings.badge_background }};
    --sf-badge-text: {{ section.settings.badge_text }};
    --sf-card-gap: {{ section.settings.card_gap }}px;
    --sf-section-padding-top: {{ section.settings.padding_top }}px;
    --sf-section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="sf-featured-products__container">
    {% if section_heading != blank or section_description != blank %}
      <div class="sf-featured-products__header">
        {% if section_heading != blank %}
          <h2 class="sf-featured-products__heading">
            {{ section_heading | escape }}
          </h2>
        {% endif %}

        {% if section_description != blank %}
          <p class="sf-featured-products__subheading">
            {{ section_description | escape }}
          </p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="sf-featured-products__grid">
        {% for block in section.blocks %}
          {% liquid
            assign card_product = block.settings.product
            assign card_image = block.settings.card_image | default: card_product.featured_image

            assign card_title = block.settings.custom_title
            if card_title == blank and card_product != blank
              assign card_title = card_product.title
            endif

            assign card_category = block.settings.custom_category
            if card_category == blank and card_product != blank
              assign card_category = card_product.type
            endif

            assign card_description = block.settings.custom_description
            if card_description == blank and card_product != blank
              assign card_description = card_product.description | strip_html | truncatewords: 18
            endif

            assign card_url = block.settings.custom_link
            if card_url == blank and card_product != blank
              assign card_url = card_product.url
            endif
          %}

          <article class="sf-product-card" {{ block.shopify_attributes }}>
            <div class="sf-product-card__media">
              {% if card_image != blank %}
                {% if card_url != blank %}
                  <a href="{{ card_url }}" class="sf-product-card__image-link">
                {% endif %}

                {{
                  card_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'sf-product-card__image',
                    widths: '300, 400, 500, 600, 750, 900',
                    sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 50vw, 100vw',
                    loading: 'lazy',
                    alt: card_title
                }}

                {% if card_url != blank %}
                  </a>
                {% endif %}
              {% else %}
                <div class="sf-product-card__placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'sf-product-card__placeholder-svg' }}
                </div>
              {% endif %}

              {% if block.settings.badge_text != blank %}
                <div class="sf-product-card__badge">
                  {% if block.settings.show_badge_star %}
                    <span class="sf-product-card__badge-star" aria-hidden="true">★</span>
                  {% endif %}

                  <span>{{ block.settings.badge_text | escape }}</span>
                </div>
              {% endif %}
            </div>

            <div class="sf-product-card__content">
              {% if block.settings.show_reviews %}
                <div class="sf-product-card__reviews">
                  <span
                    class="sf-product-card__stars"
                    aria-label="{{ block.settings.rating_text | escape }}"
                  >
                    {{ block.settings.stars | escape }}
                  </span>

                  {% if block.settings.sold_text != blank %}
                    <span class="sf-product-card__sold-text">
                      {{ block.settings.sold_text | escape }}
                    </span>
                  {% endif %}
                </div>
              {% endif %}

              {% if card_title != blank %}
                <h3 class="sf-product-card__title">
                  {% if card_url != blank %}
                    <a href="{{ card_url }}">
                      {{ card_title | escape }}
                    </a>
                  {% else %}
                    {{ card_title | escape }}
                  {% endif %}
                </h3>
              {% endif %}

              {% if card_product != blank or card_category != blank %}
                <div class="sf-product-card__meta">
                  {% if card_product != blank %}
                    <span class="sf-product-card__price">
                      {{ card_product.price | money }}
                    </span>
                  {% endif %}

                  {% if card_product != blank and card_category != blank %}
                    <span class="sf-product-card__meta-divider" aria-hidden="true"></span>
                  {% endif %}

                  {% if card_category != blank %}
                    <span class="sf-product-card__category">
                      {{ card_category | escape }}
                    </span>
                  {% endif %}
                </div>
              {% endif %}

              {% if card_description != blank %}
                <p class="sf-product-card__description">
                  {{ card_description | escape }}
                </p>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <a
                  {% if card_url != blank %}
                    href="{{ card_url }}"
                  {% else %}
                    role="link"
                    aria-disabled="true"
                  {% endif %}
                  class="sf-product-card__button"
                >
                  {{ block.settings.button_label | escape }}
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #SlimfairFeaturedProducts-{{ section.id }} {
    background-color: var(--sf-section-background);
    padding: var(--sf-section-padding-top) 40px var(--sf-section-padding-bottom);
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-featured-products__container {
    width: 100%;
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-featured-products__header {
    max-width: 980px;
    margin: 0 auto {{ section.settings.header_spacing }}px;
    text-align: center;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-featured-products__heading {
    margin: 0;
    color: var(--sf-heading-color, #5C3F2D);
    text-align: center;
    font-family: Lora, Georgia, serif;
    font-size: 32px;
    font-style: normal;
    font-weight: 700;
    line-height: 1.25;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-featured-products__subheading {
    margin: 8px 0 0;
    color: var(--sf-text-color, #5C3F2D);
    text-align: center;
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.6;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-featured-products__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: var(--sf-card-gap);
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__media {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.image_border_radius }}px;
    background-color: #f4eee4;
    aspect-ratio: {{ section.settings.image_ratio }};
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    transition: transform 0.4s ease;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card:hover .sf-product-card__image {
    transform: scale(1.03);
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__placeholder-svg {
    width: 100%;
    height: 100%;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__badge {
    position: absolute;
    top: 11px;
    right: 10px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: calc(100% - 20px);
    padding: 9px 14px;
    border-radius: 40px;
    background-color: var(--sf-badge-background);
    color: var(--sf-badge-text);
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 12px;
    font-style: normal;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__badge-star {
    color: var(--sf-badge-text);
    font-size: 15px;
    line-height: 1;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding-top: 12px;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__reviews {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 8px;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__stars {
    color: var(--sf-accent-color);
    font-family: Arial, sans-serif;
    font-size: 17px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 1px;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__sold-text {
    color: var(--sf-text-color);
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 13px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.3;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__title {
    display: block;
    width: 100%;
    margin: 0 0 10px;
    overflow: hidden;
    color: var(--sf-heading-color, #5C3F2D);
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: Lora, Georgia, serif;
    font-size: 20px;
    font-style: normal;
    font-weight: 700;
    line-height: 1.3;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__title a:hover {
    opacity: 0.8;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
    color: var(--sf-text-color);
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 13px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.45;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__price {
    font-size: 14px;
    font-weight: 500;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__meta-divider {
    display: inline-block;
    width: 1px;
    height: 15px;
    background-color: var(--sf-text-color);
    opacity: 0.65;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__description {
    display: -webkit-box;
    overflow: hidden;
    margin: 0 0 14px;
    color: var(--sf-text-color, #5C3F2D);
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__button {
    display: inline-flex;
    width: 100%;
    min-height: 54px;
    margin-top: auto;
    align-items: center;
    justify-content: center;
    padding: 14px 20px;
    border-radius: {{ section.settings.button_border_radius }}px;
    background-color: var(--sf-button-background);
    color: var(--sf-button-text);
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__button:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__button[aria-disabled="true"] {
    cursor: not-allowed;
    opacity: 0.55;
  }

  @media screen and (max-width: 1199px) {
    #SlimfairFeaturedProducts-{{ section.id }} {
      padding-right: 28px;
      padding-left: 28px;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-featured-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #SlimfairFeaturedProducts-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-right: 15px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      padding-left: 15px;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-featured-products__header {
      margin-bottom: 28px;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-featured-products__heading {
      font-size: 26px;
      line-height: 1.3;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-featured-products__subheading {
      margin-top: 8px;
      font-size: 14px;
      line-height: 1.55;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-featured-products__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 26px 14px;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__badge {
      top: 8px;
      right: 8px;
      padding: 7px 10px;
      font-size: 10px;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__badge-star {
      font-size: 12px;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__stars {
      font-size: 14px;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__sold-text {
      font-size: 12px;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__title {
      margin-bottom: 7px;
      font-size: 17px;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__meta {
      font-size: 12px;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__price {
      font-size: 13px;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__description {
      margin-bottom: 12px;
      font-size: 13px;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__button {
      min-height: 48px;
      padding: 12px 10px;
      font-size: 16px;
    }
  }

  @media screen and (max-width: 479px) {
    #SlimfairFeaturedProducts-{{ section.id }} .sf-featured-products__grid {
      {% if section.settings.columns_mobile == '1' %}
        grid-template-columns: 1fr;
      {% else %}
        grid-template-columns: repeat(2, minmax(0, 1fr));
      {% endif %}
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__image,
    #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card__button {
      transition: none;
    }

    #SlimfairFeaturedProducts-{{ section.id }} .sf-product-card:hover .sf-product-card__image {
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "Slimfair products",
  "tag": "section",
  "class": "section-slimfair-featured-products",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Heading content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Your Perfect Blend"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Subheading",
      "default": "Our most-loved, award-winning formulas designed to elevate your daily wellness and beauty ritual."
    },
    {
      "type": "header",
      "content": "Section colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F7FBEA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#5C3F2D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#5C3F2D"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Review stars color",
      "default": "#49704B"
    },
    {
      "type": "header",
      "content": "Badge style"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#C18A4F"
    },
    {
      "type": "color",
      "id": "badge_text",
      "label": "Badge text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#49704B"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Product card images"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "1 / 1",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "5 / 4",
          "label": "Landscape"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1260
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Products per row on desktop",
      "default": "4",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Spacing below heading",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop padding top",
      "min": 20,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop padding bottom",
      "min": 20,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Products per row on mobile",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Choose product"
        },
        {
          "type": "header",
          "content": "Optional overrides"
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Custom card image",
          "info": "Leave blank to use the selected product featured image."
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom product title",
          "info": "Leave blank to use the selected product title."
        },
        {
          "type": "text",
          "id": "custom_category",
          "label": "Custom category text",
          "info": "Leave blank to use the selected product type."
        },
        {
          "type": "textarea",
          "id": "custom_description",
          "label": "Custom description",
          "info": "Leave blank to use a shortened version of the product description."
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom link",
          "info": "Leave blank to link to the selected product."
        },
        {
          "type": "header",
          "content": "Badge"
        },
        {
          "type": "checkbox",
          "id": "show_badge_star",
          "label": "Show star icon in badge",
          "default": true
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "Slimming & Detox"
        },
        {
          "type": "header",
          "content": "Review row"
        },
        {
          "type": "checkbox",
          "id": "show_reviews",
          "label": "Show reviews",
          "default": true
        },
        {
