<section
  class="custom-switch-reviews"
  data-switch-reviews-id="{{ section.id }}"
  style="
    --switch-reviews-bg: {{ section.settings.background_color }};
    --switch-reviews-heading: {{ section.settings.heading_color }};
    --switch-reviews-text: {{ section.settings.text_color }};
    --switch-reviews-accent: {{ section.settings.accent_color }};
    --switch-reviews-card-bg: {{ section.settings.card_background_color }};
    --switch-reviews-line: {{ section.settings.line_color }};
    --switch-reviews-max-width: {{ section.settings.max_width | default: 1160 }}px;
    --switch-reviews-padding-top: {{ section.settings.padding_top }}px;
    --switch-reviews-padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="custom-switch-reviews__inner page-width">
    <div class="custom-switch-reviews__header">
      {% if section.settings.rating_text != blank %}
        <div class="custom-switch-reviews__rating" aria-label="{{ section.settings.rating_text | escape }}">
          <span class="custom-switch-reviews__stars" aria-hidden="true">
            {% for i in (1..5) %}
              <span>★</span>
            {% endfor %}
          </span>
          <span>{{ section.settings.rating_text | escape }}</span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="custom-switch-reviews__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="custom-switch-reviews__viewport">
        <button
          type="button"
          class="custom-switch-reviews__arrow custom-switch-reviews__arrow--prev"
          data-switch-reviews-prev
          aria-label="Scroll reviews left">
          <img
            src="{{ 'arrow-left-green.png' | asset_url }}"
            alt=""
            aria-hidden="true"
            loading="lazy"
            width="39"
            height="25">
        </button>

        <div class="custom-switch-reviews__track" data-switch-reviews-track>
          {% for block in section.blocks %}
            <article class="custom-switch-reviews__card" {{ block.shopify_attributes }}>
              <div class="custom-switch-reviews__card-stars" aria-hidden="true">
                {% for i in (1..5) %}
                  <span>★</span>
                {% endfor %}
              </div>

              {% if block.settings.title != blank %}
                <h3 class="custom-switch-reviews__card-title">{{ block.settings.title | escape }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="custom-switch-reviews__quote rte-setting">{{ block.settings.text }}</div>
              {% endif %}

              {% if block.settings.name != blank %}
                <p class="custom-switch-reviews__name">{{ block.settings.name | escape }}</p>
              {% endif %}

              {% if block.settings.badge != blank %}
                <p class="custom-switch-reviews__badge">
                  {% if block.settings.badge_icon != blank %}
                    <img
                      class="custom-switch-reviews__badge-icon"
                      src="{{ block.settings.badge_icon | image_url: width: 32 }}"
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      width="12"
                      height="12">
                  {% else %}
                    <span class="custom-switch-reviews__badge-fallback" aria-hidden="true">◎</span>
                  {% endif %}
                  <span>{{ block.settings.badge | escape }}</span>
                </p>
              {% endif %}
            </article>
          {% endfor %}
        </div>

        <button
          type="button"
          class="custom-switch-reviews__arrow custom-switch-reviews__arrow--next"
          data-switch-reviews-next
          aria-label="Scroll reviews right">
          <img
            src="{{ 'arrow-right-green.png' | asset_url }}"
            alt=""
            aria-hidden="true"
            loading="lazy"
            width="39"
            height="25">
        </button>
      </div>

      <div class="custom-switch-reviews__progress" aria-hidden="true">
        <span></span>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .custom-switch-reviews {
    background: var(--switch-reviews-bg);
    color: var(--switch-reviews-text);
    overflow: hidden;
    padding: var(--switch-reviews-padding-top) 0 var(--switch-reviews-padding-bottom);
  }

  .custom-switch-reviews__inner.page-width {
    max-width: var(--switch-reviews-max-width);
    padding-left: 0;
    padding-right: 0;
  }

  .custom-switch-reviews__header {
    margin: 0 auto 36px;
    max-width: 620px;
    text-align: center;
  }

  .custom-switch-reviews__rating {
    align-items: center;
    color: var(--switch-reviews-text);
    display: inline-flex;
    font-size: 16px;
    gap: 7px;
    line-height: 1.1;
    margin-bottom: 6px;
  }

  .custom-switch-reviews__stars,
  .custom-switch-reviews__card-stars {
    color: var(--switch-reviews-accent);
    display: inline-flex;
    gap: 1px;
    letter-spacing: 0;
    line-height: 1;
  }

  .custom-switch-reviews__stars {
    font-size: 24px;
  }

  .custom-switch-reviews__heading {
    color: var(--switch-reviews-heading);
    font-family: Lora
    , serif;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.22;
    margin: 0;
    text-transform:none;
  }

  .custom-switch-reviews__viewport {
    align-items: center;
    display: grid;
    gap: 18px;
    grid-template-columns: 34px minmax(0, 1fr) 34px;
  }

  .custom-switch-reviews__track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    padding: 0 0 2px;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    justify-content: center;
  }

  .custom-switch-reviews__track::-webkit-scrollbar {
    display: none;
  }

  .custom-switch-reviews__card {
    background: var(--switch-reviews-card-bg);
    border-radius: 8px;
    box-sizing: border-box;
    display: grid;
    flex: 0 0 236px;
    grid-template-rows: auto auto minmax(0, 1fr) auto auto;
    height: 252px;
    padding: 22px 24px 20px;
    scroll-snap-align: start;
    text-align: center;
  }

  .custom-switch-reviews__card-stars {
    font-size: 24px;
    justify-content: center;
    margin-bottom: 10px;
    color: var(--switch-reviews-accent);
  }

  .custom-switch-reviews__card-title {
    color: var(--switch-reviews-heading);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.25;
    margin: 0 0 14px;
    text-transform:none;
  }

  .custom-switch-reviews__quote,
  .custom-switch-reviews__quote.rte-setting {
    color: #111;
    font-size: 13px;
    line-height: 1.45;
    margin: 0;
    min-height: 0;
    overflow-y: auto;
    padding-right: 0;
    scrollbar-color: rgba(73, 112, 75, 0.55) transparent;
    scrollbar-width: thin;
  }

  .custom-switch-reviews__quote::-webkit-scrollbar,
  .custom-switch-reviews__quote.rte-setting::-webkit-scrollbar {
    width: 3px;
  }

  .custom-switch-reviews__quote::-webkit-scrollbar-button,
  .custom-switch-reviews__quote.rte-setting::-webkit-scrollbar-button {
    display: none;
    height: 0;
    width: 0;
  }

  .custom-switch-reviews__quote::-webkit-scrollbar-track,
  .custom-switch-reviews__quote.rte-setting::-webkit-scrollbar-track {
    background: transparent;
  }

  .custom-switch-reviews__quote::-webkit-scrollbar-thumb,
  .custom-switch-reviews__quote.rte-setting::-webkit-scrollbar-thumb {
    background: rgba(73, 112, 75, 0.55);
    border-radius: 999px;
  }

  .custom-switch-reviews__quote::-webkit-scrollbar-thumb:hover,
  .custom-switch-reviews__quote.rte-setting::-webkit-scrollbar-thumb:hover {
    background: rgba(73, 112, 75, 0.75);
  }

  .custom-switch-reviews__quote p {
    margin: 0;
    font-size: 16px;
    color: #000;
  }

  .custom-switch-reviews__name {
    color: #111;
    font-size: 12px;
    font-weight: 700 !important;
    line-height: 1.25;
    margin: 18px 0 4px;
  }

  .custom-switch-reviews__badge {
    align-items: center;
    color: #C48645;
    display: inline-flex;
    font-size: 12px;
    gap: 4px;
    line-height: 1.2;
    margin: 0;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .custom-switch-reviews__badge-icon {
    display: block;
    height: 16px;
    object-fit: contain;
    width: 16px;
  }

  .custom-switch-reviews__badge-fallback {
    line-height: 1;
  }

  .custom-switch-reviews__arrow {
    align-items: center;
    background: transparent;
    border: 0;
    display: inline-flex;
    height: 25px;
    justify-content: center;
    padding: 0;
    width: 39px;
  }

  .custom-switch-reviews__arrow img {
    display: block;
    height: 100%;
    width: 100%;
  }

  .custom-switch-reviews__progress {
    background: rgba(255, 255, 255, 0.75);
    height: 4px;
    margin: 40px auto 0;
    max-width: 940px;
    position: relative;
  }

  .custom-switch-reviews__progress span {
    background: var(--switch-reviews-line);
    display: block;
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    width: 0;
  }

  @media screen and (max-width: 749px) {
    .custom-switch-reviews {
      padding: 68px 0 64px;
    }

    .custom-switch-reviews__inner.page-width {
      padding-left: 16px;
      padding-right: 0;
    }

    .custom-switch-reviews__header {
      margin: 0 21px 38px 0;
      max-width: none;
    }

    .custom-switch-reviews__rating {
      font-size: 16px;
      gap: 7px;
      margin-bottom: 8px;
    }

    .custom-switch-reviews__stars {
      font-size: 22px;
    }

    .custom-switch-reviews__heading {
      font-size: 24px;
      line-height: 1.12;
      text-transform: uppercase;
    }

    .custom-switch-reviews__viewport {
      align-items: center;
      display: block;
      margin-right: 0;
      position: relative;
    }

    .custom-switch-reviews__track {
      gap: 18px;
      justify-content: flex-start;
      padding: 0 calc(50vw - 8px);
      scroll-padding-left: 2px;
    }

    .custom-switch-reviews__card {
      border-radius: 8px;
      flex: 0 0 clamp(216px, 60vw, 236px);
      height: 252px;
      padding: 24px 22px 20px;
    }

    .custom-switch-reviews__card-stars {
      font-size: 22px;
      margin-bottom: 11px;
    }

    .custom-switch-reviews__card-title {
      font-size: 16px;
      margin-bottom: 16px;
    }

    .custom-switch-reviews__quote,
    .custom-switch-reviews__quote.rte-setting {
      color: #000;
      font-size: 14px;
      line-height: 1.45;
    }

    .custom-switch-reviews__name {
      font-size: 14px;
      font-weight: 800 !important;
      margin-top: 20px;
    }

    .custom-switch-reviews__badge {
      font-size: 12px;
    }

    .custom-switch-reviews__arrow {
      height: 25px;
      position: absolute;
      top: calc(100% + 44px);
      transform: translateY(-50%);
      width: 39px;
      z-index: 2;
    }

    .custom-switch-reviews__arrow--prev {
      right: 64px;
    }

    .custom-switch-reviews__arrow--next {
      right: 16px;
    }

    .custom-switch-reviews__progress {
      height: 4px;
      margin: 42px 112px 0 0;
      max-width: none;
    }

    .custom-switch-reviews__progress span {
      width: 100%;
    }
  }
</style>

<script>
  (function() {
    var section = document.querySelector('[data-switch-reviews-id="{{ section.id }}"]');
    if (!section) return;

    var track = section.querySelector('[data-switch-reviews-track]');
    var prev = section.querySelector('[data-switch-reviews-prev]');
    var next = section.querySelector('[data-switch-reviews-next]');
    var progress = section.querySelector('.custom-switch-reviews__progress span');

    function getCardPositions() {
      if (!track) return [];
      var cards = track.querySelectorAll('.custom-switch-reviews__card');
      return Array.prototype.map.call(cards, function(card) {
        return card.offsetLeft - track.offsetLeft;
      });
    }

    function scrollByCard(direction) {
      if (!track) return;
      var positions = getCardPositions();
      if (!positions.length) return;

      var current = track.scrollLeft;
      var target = positions[0];
      var tolerance = 4;

      if (direction > 0) {
        target = positions[positions.length - 1];
        for (var i = 0; i < positions.length; i++) {
          if (positions[i] > current + tolerance) {
            target = positions[i];
            break;
          }
        }
      } else {
        for (var j = positions.length - 1; j >= 0; j--) {
          if (positions[j] < current - tolerance) {
            target = positions[j];
            break;
          }
        }
      }

      track.scrollTo({ left: target, behavior: 'smooth' });
    }

    function updateProgress() {
      if (!track || !progress) return;

      var maxScroll = track.scrollWidth - track.clientWidth;
      if (maxScroll <= 0) {
        progress.style.width = '100%';
        progress.style.left = '0';
        return;
      }

      var visiblePercent = (track.clientWidth / track.scrollWidth) * 100;
      var clampedVisiblePercent = Math.max(10, Math.min(100, visiblePercent));
      var ratio = track.scrollLeft / maxScroll;
      var leftPercent = ratio * (100 - clampedVisiblePercent);

      progress.style.width = clampedVisiblePercent + '%';
      progress.style.left = leftPercent + '%';
    }

    function resetToFirstCardOnMobile() {
      if (!track || !window.matchMedia('(max-width: 749px)').matches) return;
      track.scrollTo({ left: 0, behavior: 'auto' });
    }

    if (prev) prev.addEventListener('click', function() { scrollByCard(-1); });
    if (next) next.addEventListener('click', function() { scrollByCard(1); });
    if (track) track.addEventListener('scroll', updateProgress);
    window.addEventListener('resize', function() {
      resetToFirstCardOnMobile();
      updateProgress();
    });
    resetToFirstCardOnMobile();
    updateProgress();
  })();
</script>

