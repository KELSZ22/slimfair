{% assign section_id = section.id %}
{% assign section_image = section.settings.image %}

<section class="custom-routine-tips custom-routine-tips--{{ section_id }}" style="
    --routine-tips-bg: {{ section.settings.background_color }};
    --routine-tips-heading: {{ section.settings.heading_color }};
    --routine-tips-text: {{ section.settings.text_color }};
    --routine-tips-pill-bg: {{ section.settings.pill_background_color }};
    --routine-tips-pill-text: {{ section.settings.pill_text_color }};
    --routine-tips-pill-border: {{ section.settings.pill_border_color }};
    --routine-tips-radius: {{ section.settings.image_radius }}px;
    --routine-tips-padding-top: {{ section.settings.padding_top }}px;
    --routine-tips-padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="custom-routine-tips__inner page-width custom-routine-tips__inner--{{ section.settings.image_position }}">
    <div class="custom-routine-tips__media">
      {% if section_image != blank %}
        <img
          src="{{ section_image | img_url: '760x760' }}"
          srcset="
            {{ section_image | img_url: '420x420' }} 420w,
            {{ section_image | img_url: '620x620' }} 620w,
            {{ section_image | img_url: '760x760' }} 760w,
            {{ section_image | img_url: '960x960' }} 960w
          "
          sizes="(min-width: 990px) 45vw, 92vw"
          alt="{{ section_image.alt | escape }}"
          loading="lazy">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg custom-routine-tips__placeholder' }}
      {% endif %}
    </div>

    <div class="custom-routine-tips__content">
      {% if section.settings.heading != blank %}
        <h2 class="custom-routine-tips__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="custom-routine-tips__text rte-setting">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="custom-routine-tips__list custom-routine-tips__list--{{ section.settings.columns }}">
          {% for block in section.blocks %}
            <article class="custom-routine-tips__item" {{ block.shopify_attributes }}>
              <div class="custom-routine-tips__icon" aria-hidden="true">
                <img
                  src="{{ 'brown-check.svg' | asset_url }}"
                  alt=""
                  width="22"
                  height="22"
                  loading="lazy">
              </div>

              <div class="custom-routine-tips__item-copy">
                {% if block.settings.title != blank %}
                  <h3 class="custom-routine-tips__pill">{{ block.settings.title | escape }}</h3>
                {% endif %}

                {% if block.settings.description != blank %}
                  <div class="custom-routine-tips__description rte-setting">{{ block.settings.description }}</div>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .custom-routine-tips {
    background: var(--routine-tips-bg);
    color: var(--routine-tips-text);
    padding: var(--routine-tips-padding-top) 0 var(--routine-tips-padding-bottom);
  }

  .custom-routine-tips__inner.page-width {
    max-width: 1360px;
    padding: 0;
  }

  .custom-routine-tips__inner {
    align-items: center;
    display: grid;
    gap: 74px;
    grid-template-columns: minmax(280px, 1fr) minmax(320px, 1.1fr);
  }

  .custom-routine-tips__inner--right .custom-routine-tips__media {
    order: 2;
  }

  .custom-routine-tips__media {
    border-radius: var(--routine-tips-radius);
    overflow: hidden;
  }

  .custom-routine-tips__media img,
  .custom-routine-tips__placeholder {
    aspect-ratio: 1 / 1;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .custom-routine-tips__placeholder {
    background: #f7e9ca;
    min-height: 360px;
  }

  .custom-routine-tips__heading {
    color: var(--routine-tips-heading);
    font-family: Lora
    , serif;
    font-size: 33px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
  }

  .custom-routine-tips__text,
  .custom-routine-tips__text.rte-setting p {
    color: var(--routine-tips-text);
    font-size: 18px;
    font-weight: 400;

  }

  .custom-routine-tips__description p {
    color: inherit;
    margin: 0;
    font-size: 14px;
  }
  .custom-routine-tips__description {
    font-size: 18px;
  }

  .custom-routine-tips__list {
    display: grid;
    gap: 16px 28px;
  }

  .custom-routine-tips__list--one {
    grid-template-columns: 1fr;
    max-width: 520px;
  }

  .custom-routine-tips__list--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 32px;
  }

  .custom-routine-tips__item {
    align-items: flex-start;
    display: grid;
    gap: 20px;
    grid-template-columns: 14px minmax(0, 1fr);
  }

  .custom-routine-tips__icon {
    flex-shrink: 0;
    line-height: 0;
    margin-top: 4px;
  }

  .custom-routine-tips__icon img {
    display: block;
    height: auto;
    width: 22px;
    max-width: none;
  }

  .custom-routine-tips__pill {
    align-items: center;
    background: var(--routine-tips-pill-bg);
    border: 1px solid var(--routine-tips-pill-border);
    border-radius: 999px;
    color: var(--routine-tips-pill-text);
    display: flex;
    font-size: 16px;
    font-weight: 700;
    justify-content: center;
    line-height: 1.25;
    margin: 0 0 11px;
    min-height: 32px;
    padding: 12px 18px;
    text-align: center;
  }

  .custom-routine-tips__description,
  .custom-routine-tips__description.rte-setting {
    color: var(--routine-tips-text);
    font-size: 13px;
    line-height: 1.48;
  }

  @media screen and (max-width: 989px) {
    .custom-routine-tips__inner {
      gap: 16px;
      grid-template-columns: 1fr;
    }

    .custom-routine-tips__inner--right .custom-routine-tips__media {
      order: 0;
    }
    .custom-routine-tips__pill {
      font-size: 14px;
      width: 80%;
    }
  }

  @media screen and (max-width: 649px) {
    .custom-routine-tips {
      padding: 16px;
    }

    .custom-routine-tips__heading {
      font-size: 18px;
      margin-bottom: 14px;
    }

    .custom-routine-tips__text,
    .custom-routine-tips__text.rte-setting {
      font-size: 14px;
      margin-bottom: 24px;
    }

    .custom-routine-tips__text,
    .custom-routine-tips__text.rte-setting p {
      font-size: 16px;
    }

    .custom-routine-tips__list--two {
      grid-template-columns: 1fr;
    }

    .custom-routine-tips__pill {
      justify-content: center;
      min-height: 30px;
    }
  }
</style>

{% schema %}
