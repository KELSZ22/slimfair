{% assign section_image = section.settings.image %}

<section class="custom-simple-steps" style="
    --simple-steps-bg: {{ section.settings.background_color | default: '#FFFBD8' }};
    --simple-steps-heading: {{ section.settings.heading_color | default: '#5C3F2D' }};
    --simple-steps-text: {{ section.settings.text_color | default: '#6D563D' }};
    --simple-steps-accent: {{ section.settings.accent_color | default: '#68422E' }};
    --simple-steps-icon-color: {{ section.settings.icon_color | default: '#FFFFFF' }};
    --simple-steps-number-bg: {{ section.settings.number_background_color | default: '#F3E59B' }};
    --simple-steps-number-text: {{ section.settings.number_text_color | default: '#6D563D' }};
    --simple-steps-padding-top: {{ section.settings.padding_top | default: 52 }}px;
    --simple-steps-padding-bottom: {{ section.settings.padding_bottom | default: 52 }}px;
    --simple-steps-max-width: {{ section.settings.max_width | default: 1160 }}px;
    --simple-steps-layout-gap: {{ section.settings.layout_gap | default: 72 }}px;
    --simple-steps-content-width: {{ section.settings.content_width | default: 560 }}px;
    --simple-steps-image-radius: {{ section.settings.image_radius | default: 34 }}px;
    --simple-steps-image-size: {{ section.settings.image_size | default: 559 }}px;
    --simple-steps-image-aspect: {{ section.settings.image_aspect_width | default: 559 }} / {{ section.settings.image_aspect_height | default: 559 }};
    --simple-steps-heading-size: {{ section.settings.heading_size | default: 31 }}px;
    --simple-steps-text-size: {{ section.settings.text_size | default: 15 }}px;
    --simple-steps-step-title-size: {{ section.settings.step_title_size | default: 14 }}px;
    --simple-steps-step-text-size: {{ section.settings.step_text_size | default: 12 }}px;
    --simple-steps-list-gap: {{ section.settings.list_gap | default: 26 }}px;
    --simple-steps-step-gap: {{ section.settings.step_gap | default: 20 }}px;
    --simple-steps-icon-size: {{ section.settings.icon_size | default: 64 }}px;
    --simple-steps-number-size: {{ section.settings.number_size | default: 23 }}px;
    --simple-steps-mobile-padding-top: {{ section.settings.mobile_padding_top | default: 10 }}px;
    --simple-steps-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom | default: 18 }}px;
    --simple-steps-mobile-page-padding: {{ section.settings.mobile_page_padding | default: 10 }}px;
    --simple-steps-mobile-layout-gap: {{ section.settings.mobile_layout_gap | default: 12 }}px;
    --simple-steps-mobile-image-radius: {{ section.settings.mobile_image_radius | default: 8 }}px;
    --simple-steps-mobile-image-aspect: {{ section.settings.mobile_image_aspect_width | default: 272 }} / {{ section.settings.mobile_image_aspect_height | default: 245 }};
    --simple-steps-mobile-heading-size: {{ section.settings.mobile_heading_size | default: 17 }}px;
    --simple-steps-mobile-text-size: {{ section.settings.mobile_text_size | default: 11 }}px;
    --simple-steps-mobile-step-title-size: {{ section.settings.mobile_step_title_size | default: 11 }}px;
    --simple-steps-mobile-step-text-size: {{ section.settings.mobile_step_text_size | default: 10 }}px;
    --simple-steps-mobile-list-gap: {{ section.settings.mobile_list_gap | default: 9 }}px;
    --simple-steps-mobile-step-gap: {{ section.settings.mobile_step_gap | default: 8 }}px;
    --simple-steps-mobile-icon-size: {{ section.settings.mobile_icon_size | default: 48 }}px;
    --simple-steps-mobile-number-size: {{ section.settings.mobile_number_size | default: 22 }}px;
  ">
  <div class="custom-simple-steps__inner page-width custom-simple-steps__inner--{{ section.settings.image_position | default: 'right' }}">
    <div class="custom-simple-steps__content">
      {% if section.settings.heading != blank %}
        <h2 class="custom-simple-steps__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="custom-simple-steps__text rte-setting">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="custom-simple-steps__list">
          {% for block in section.blocks %}
            {% assign step_icon = block.settings.icon | default: 'water' %}
            {% assign mobile_step_icon = block.settings.mobile_icon | default: 'inherit' %}
            {% if mobile_step_icon == 'inherit' %}
              {% assign mobile_step_icon = step_icon %}
            {% endif %}

            <article class="custom-simple-steps__step" {{ block.shopify_attributes }}>
              <div class="custom-simple-steps__icon custom-simple-steps__icon--{{ step_icon }}" aria-hidden="true">
                <span class="custom-simple-steps__icon-art custom-simple-steps__icon-art--desktop">
                  {% if block.settings.icon_image != blank %}
                    <img
                      class="custom-simple-steps__icon-image"
                      src="{{ block.settings.icon_image | img_url: '96x' }}"
                      alt=""
                      loading="lazy">
                  {% elsif step_icon == 'water' %}
                    <span class="custom-simple-steps__icon-shape custom-simple-steps__icon-shape--drop"></span>
                    <span class="custom-simple-steps__icon-shape custom-simple-steps__icon-shape--cup"></span>
                  {% elsif step_icon == 'sachet' %}
                    <span class="custom-simple-steps__icon-shape custom-simple-steps__icon-shape--pack"></span>
                  {% elsif step_icon == 'check' %}
                    <span class="custom-simple-steps__icon-shape custom-simple-steps__icon-shape--check"></span>
                  {% else %}
                    <span class="custom-simple-steps__icon-shape custom-simple-steps__icon-shape--person"></span>
                    <span class="custom-simple-steps__icon-shape custom-simple-steps__icon-shape--cup-small"></span>
                  {% endif %}
                </span>

                <span class="custom-simple-steps__icon-art custom-simple-steps__icon-art--mobile custom-simple-steps__icon-art--{{ mobile_step_icon }}">
                  {% if block.settings.mobile_icon_image != blank %}
                    <img
                      class="custom-simple-steps__icon-image"
                      src="{{ block.settings.mobile_icon_image | img_url: '96x' }}"
                      alt=""
                      loading="lazy">
                  {% elsif mobile_step_icon == 'water' %}
                    <span class="custom-simple-steps__icon-shape custom-simple-steps__icon-shape--drop"></span>
                    <span class="custom-simple-steps__icon-shape custom-simple-steps__icon-shape--cup"></span>
                  {% elsif mobile_step_icon == 'sachet' %}
                    <span class="custom-simple-steps__icon-shape custom-simple-steps__icon-shape--pack"></span>
                  {% elsif mobile_step_icon == 'check' %}
                    <span class="custom-simple-steps__icon-shape custom-simple-steps__icon-shape--check"></span>
                  {% else %}
                    <span class="custom-simple-steps__icon-shape custom-simple-steps__icon-shape--person"></span>
                    <span class="custom-simple-steps__icon-shape custom-simple-steps__icon-shape--cup-small"></span>
                  {% endif %}
                </span>
              </div>

              <div class="custom-simple-steps__copy">
                <div class="custom-simple-steps__title-row">
                  {% unless section.settings.show_numbers == false %}
                    <span class="custom-simple-steps__number">
                      {% if block.settings.number_label != blank %}
                        {{ block.settings.number_label | escape }}
                      {% else %}
                        {{ forloop.index }}
                      {% endif %}
                    </span>
                  {% endunless %}

                  {% if block.settings.title != blank %}
                    <h3 class="custom-simple-steps__step-title">{{ block.settings.title | escape }}</h3>
                  {% endif %}
                </div>

                {% if block.settings.description != blank %}
                  <div class="custom-simple-steps__description rte-setting">{{ block.settings.description }}</div>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="custom-simple-steps__media">
      {% if section_image != blank %}
        <img
          src="{{ section_image | img_url: '760x' }}"
          srcset="
            {{ section_image | img_url: '480x' }} 480w,
            {{ section_image | img_url: '640x' }} 640w,
            {{ section_image | img_url: '760x' }} 760w,
            {{ section_image | img_url: '960x' }} 960w
          "
          sizes="(min-width: 990px) 48vw, 92vw"
          alt="{% if section.settings.image_alt != blank %}{{ section.settings.image_alt | escape }}{% else %}{{ section_image.alt | escape }}{% endif %}"
          loading="lazy">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg custom-simple-steps__placeholder' }}
      {% endif %}
    </div>
  </div>
</section>

<style>
  .custom-simple-steps {
    background: var(--simple-steps-bg);
    color: var(--simple-steps-text);
    padding: var(--simple-steps-padding-top) 0 var(--simple-steps-padding-bottom);
  }

  .custom-simple-steps__inner.page-width {
    max-width: var(--simple-steps-max-width);
    padding-left: 0;
    padding-right: 0;
  }

  .custom-simple-steps__inner {
    align-items: center;
    display: grid;
    gap: var(--simple-steps-layout-gap);
    grid-template-columns: minmax(280px, 0.95fr) minmax(280px, 1.05fr);
  }

  .custom-simple-steps__inner--left .custom-simple-steps__media {
    order: -1;
  }

  .custom-simple-steps__heading {
    color: var(--simple-steps-heading);
    font-family: Lora
    , serif;
    font-size: var(--simple-steps-heading-size);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .custom-simple-steps__text,
  .custom-simple-steps__text.rte-setting {
    color: var(--simple-steps-text);
    font-size: var(--simple-steps-text-size);
    line-height: 1.55;
    margin: 0 0 38px;
    max-width: var(--simple-steps-content-width);
  }

  .custom-simple-steps__text p,
  .custom-simple-steps__description p {
    color: inherit;
    margin: 0;
  }

  .custom-simple-steps__list {
    display: grid;
    gap: var(--simple-steps-list-gap);
  }

  .custom-simple-steps__step {
    align-items: center;
    display: grid;
    gap: var(--simple-steps-step-gap);
    grid-template-columns: var(--simple-steps-icon-size) minmax(0, 1fr);
  }

  .custom-simple-steps__icon {
    align-items: center;
    background: var(--simple-steps-accent);
    border-radius: 50%;
    color: var(--simple-steps-icon-color);
    display: flex;
    height: var(--simple-steps-icon-size);
    justify-content: center;
    position: relative;
    width: var(--simple-steps-icon-size);
  }

  .custom-simple-steps__icon-image {
    display: block;
    height: 58%;
    max-height: 44px;
    max-width: 44px;
    object-fit: contain;
    width: 58%;
  }

  .custom-simple-steps__icon-art {
    align-items: center;
    display: flex;
    inset: 0;
    justify-content: center;
    position: absolute;
  }

  .custom-simple-steps__icon-art--mobile {
    display: none;
  }

  .custom-simple-steps__icon-shape {
    display: block;
    position: absolute;
  }

  .custom-simple-steps__icon-shape--drop {
    border: 3px solid currentColor;
    border-radius: 50% 50% 50% 0;
    height: 28%;
    left: 33%;
    top: 28%;
    transform: rotate(-45deg);
    width: 28%;
  }

  .custom-simple-steps__icon-shape--cup {
    border: 3px solid currentColor;
    border-radius: 0 0 8px 8px;
    border-top: 0;
    bottom: 27%;
    height: 25%;
    right: 28%;
    width: 25%;
  }

  .custom-simple-steps__icon-shape--pack {
    border: 3px solid currentColor;
    border-radius: 3px;
    height: 41%;
    width: 44%;
  }

  .custom-simple-steps__icon-shape--pack:before {
    border-bottom: 2px solid currentColor;
    border-left: 2px solid currentColor;
    content: "";
    height: 23%;
    left: 25%;
    position: absolute;
    top: 27%;
    transform: rotate(-45deg);
    width: 36%;
  }

  .custom-simple-steps__icon-shape--pack:after {
    border: 2px solid currentColor;
    border-radius: 50%;
    content: "";
    height: 19%;
    position: absolute;
    right: 18%;
    top: 31%;
    width: 19%;
  }

  .custom-simple-steps__icon-shape--person {
    background: currentColor;
    border-radius: 50% 50% 44% 44%;
    height: 28%;
    left: 27%;
    top: 45%;
    width: 28%;
  }

  .custom-simple-steps__icon-shape--person:before {
    background: currentColor;
    border-radius: 50%;
    content: "";
    height: 67%;
    left: 17%;
    position: absolute;
    top: -72%;
    width: 67%;
  }

  .custom-simple-steps__icon-shape--cup-small {
    border: 3px solid currentColor;
    border-radius: 0 0 8px 8px;
    border-top: 0;
    height: 27%;
    right: 28%;
    top: 42%;
    transform: rotate(-30deg);
    width: 20%;
  }

  .custom-simple-steps__icon-shape--check {
    border-bottom: 4px solid currentColor;
    border-left: 4px solid currentColor;
    height: 22%;
    transform: rotate(-45deg);
    width: 42%;
  }

  .custom-simple-steps__title-row {
    align-items: center;
    display: flex;
    gap: 12px;
    margin-bottom: 8px;
    min-width: 0;
  }

  .custom-simple-steps__number {
    align-items: center;
    background: var(--simple-steps-number-bg);
    border-radius: 50%;
    color: var(--simple-steps-number-text);
    display: inline-flex;
    flex: 0 0 var(--simple-steps-number-size);
    font-size: 12px;
    font-weight: 700;
    height: var(--simple-steps-number-size);
    justify-content: center;
    line-height: 1;
    width: var(--simple-steps-number-size);
  }

  .custom-simple-steps__step-title {
    color: var(--simple-steps-heading);
    font-size: var(--simple-steps-step-title-size);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
    margin: 0;
    min-width: 0;
  }

  .custom-simple-steps__description,
  .custom-simple-steps__description.rte-setting {
    color: var(--simple-steps-text);
    font-size: var(--simple-steps-step-text-size);
    line-height: 1.45;
  }

  .custom-simple-steps__media {
    border-radius: var(--simple-steps-image-radius);
    justify-self: center;
    max-width: var(--simple-steps-image-size);
    overflow: hidden;
    width: 100%;
  }

  .custom-simple-steps__media img,
  .custom-simple-steps__placeholder {
    aspect-ratio: var(--simple-steps-image-aspect);
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .custom-simple-steps__placeholder {
    background: #eadfc6;
  }

  .custom-simple-steps__content {
    width: 550px;
  }

  @media screen and (max-width: 899px) {
    .custom-simple-steps__inner {
      gap: 36px;
      grid-template-columns: 1fr;
    }

    .custom-simple-steps__media {
      order: -1;
    }
  }

  @media screen and (max-width: 549px) {
    .custom-simple-steps {
      padding: var(--simple-steps-mobile-padding-top) 0 var(--simple-steps-mobile-padding-bottom);
    }

    .custom-simple-steps__inner.page-width {
      padding-left: var(--simple-steps-mobile-page-padding);
      padding-right: var(--simple-steps-mobile-page-padding);
    }

    .custom-simple-steps__inner {
      gap: var(--simple-steps-mobile-layout-gap);
    }

    .custom-simple-steps__content {
      width: 100%;
    }

    .custom-simple-steps__media {
      border-radius: var(--simple-steps-mobile-image-radius);
      justify-self: center;
      margin-left: 0;
      margin-right: 0;
      max-width: none;
      width: 100%;
    }

    .custom-simple-steps__media img,
    .custom-simple-steps__placeholder {
      aspect-ratio: auto;
      height: auto;
      object-fit: contain;
    }

    .custom-simple-steps__heading {
      font-size: var(--simple-steps-mobile-heading-size);
      line-height: 1.2;
      margin-bottom: 8px;
    }

    .custom-simple-steps__text,
    .custom-simple-steps__text.rte-setting {
      font-size: var(--simple-steps-mobile-text-size);
      line-height: 1.45;
      margin-bottom: 14px;
      max-width: none;
    }

    .custom-simple-steps__list {
      gap: var(--simple-steps-mobile-list-gap);
    }

    .custom-simple-steps__step {
      align-items: start;
      gap: var(--simple-steps-mobile-step-gap);
      grid-template-columns: var(--simple-steps-mobile-icon-size) minmax(0, 1fr);
    }

    .custom-simple-steps__icon {
      background: transparent;
      border-radius: 0;
      color: var(--simple-steps-accent);
      height: var(--simple-steps-mobile-icon-size);
      margin-top: 2px;
      width: var(--simple-steps-mobile-icon-size);
    }

    .custom-simple-steps__icon-art--desktop {
      display: none;
    }

    .custom-simple-steps__icon-art--mobile {
      display: flex;
    }

    .custom-simple-steps__icon-art--mobile .custom-simple-steps__icon-image {
      height: 100%;
      max-height: none;
      max-width: none;
      width: 100%;
    }

    .custom-simple-steps__icon-shape--drop,
    .custom-simple-steps__icon-shape--cup,
    .custom-simple-steps__icon-shape--pack,
    .custom-simple-steps__icon-shape--cup-small {
      border-width: 2px;
    }

    .custom-simple-steps__icon-shape--pack:before {
      border-bottom-width: 2px;
      border-left-width: 2px;
    }

    .custom-simple-steps__icon-shape--pack:after {
      border-width: 2px;
    }

    .custom-simple-steps__icon-shape--check {
      border-bottom-width: 3px;
      border-left-width: 3px;
    }

    .custom-simple-steps__title-row {
      gap: 8px;
      margin-bottom: 4px;
    }

    .custom-simple-steps__number {
      flex-basis: var(--simple-steps-mobile-number-size);
      font-size: 11px;
      height: var(--simple-steps-mobile-number-size);
      width: var(--simple-steps-mobile-number-size);
    }

    .custom-simple-steps__step-title {
      font-size: var(--simple-steps-mobile-step-title-size);
      line-height: 1.25;
    }

    .custom-simple-steps__description,
    .custom-simple-steps__description.rte-setting {
      font-size: var(--simple-steps-mobile-step-text-size);
      line-height: 1.35;
    }
  }
</style>

{% schema %}
  {
    "name": "Simple steps",
    "class": "custom-product-stack-section",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Ready in 3 Simple Steps"
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "Text",
        "default": "<p>Enjoy a smooth, slimming coffee designed to support your metabolism and keep you feeling in control-anytime, anywhere.</p>"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "image_alt",
        "label": "Image alt text override"
      }, {
        "type": "select",
        "id": "image_position",
        "label": "Image position",
        "default": "right",
        "options": [
          {
            "value": "left",
            "label": "Left"
          }, {
            "value": "right",
            "label": "Right"
          }
        ]
      }, {
        "type": "checkbox",
        "id": "show_numbers",
        "label": "Show step numbers",
        "default": true
      }, {
        "type": "header",
        "content": "Colors"
      }, {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#FFFBD8"
      }, {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#5C3F2D"
      }, {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#6D563D"
      }, {
        "type": "color",
        "id": "accent_color",
        "label": "Icon background",
        "default": "#68422E"
      }, {
        "type": "color",
        "id": "icon_color",
        "label": "Icon color",
        "default": "#FFFFFF"
      }, {
        "type": "color",
        "id": "number_background_color",
        "label": "Step number background",
        "default": "#F3E59B"
      }, {
        "type": "color",
        "id": "number_text_color",
        "label": "Step number text",
        "default": "#6D563D"
      }, {
        "type": "header",
        "content": "Desktop layout"
      }, {
        "type": "range",
        "id": "max_width",
        "label": "Content max width",
        "min": 960,
        "max": 1440,
        "step": 20,
        "unit": "px",
        "default": 1160
      }, {
        "type": "range",
        "id": "layout_gap",
        "label": "Image and text gap",
        "min": 16,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 72
      }, {
        "type": "range",
        "id": "content_width",
        "label": "Text max width",
        "min": 320,
        "max": 760,
        "step": 20,
        "unit": "px",
        "default": 560
      }, {
        "type": "range",
        "id": "image_radius",
        "label": "Image corner radius",
        "min": 0,
        "max": 44,
        "step": 2,
        "unit": "px",
        "default": 34
      }, {
        "type": "range",
        "id": "image_size",
        "label": "Image size",
        "min": 520,
        "max": 620,
        "step": 1,
        "unit": "px",
        "default": 559
      }, {
        "type": "range",
        "id": "image_aspect_width",
        "label": "Image aspect width",
        "min": 500,
        "max": 600,
        "step": 1,
        "default": 559
      }, {
        "type": "range",
        "id": "image_aspect_height",
        "label": "Image aspect height",
        "min": 500,
        "max": 600,
        "step": 1,
        "default": 559
      }, {
        "type": "header",
        "content": "Desktop type and items"
      }, {
        "type": "range",
        "id": "heading_size",
        "label": "Heading size",
        "min": 18,
        "max": 56,
        "step": 1,
        "unit": "px",
        "default": 31
      }, {
        "type": "range",
        "id": "text_size",
        "label": "Text size",
        "min": 10,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 15
      }, {
        "type": "range",
        "id": "step_title_size",
        "label": "Step title size",
        "min": 10,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 14
      }, {
        "type": "range",
        "id": "step_text_size",
        "label": "Step text size",
        "min": 10,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 12
      }, {
        "type": "range",
        "id": "list_gap",
        "label": "Space between steps",
        "min": 4,
        "max": 56,
        "step": 1,
        "unit": "px",
        "default": 26
      }, {
        "type": "range",
        "id": "step_gap",
        "label": "Icon and text gap",
        "min": 4,
        "max": 40,
        "step": 1,
        "unit": "px",
        "default": 20
      }, {
        "type": "range",
        "id": "icon_size",
        "label": "Icon size",
        "min": 28,
        "max": 96,
        "step": 1,
        "unit": "px",
        "default": 64
      }, {
        "type": "range",
