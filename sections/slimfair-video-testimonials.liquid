{% liquid
  assign section_id = 'SlimfairVideoTestimonials-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="sf-video-testimonials"
  style="
    --sf-vt-background: {{ section.settings.background_color }};
    --sf-vt-heading-color: {{ section.settings.heading_color }};
    --sf-vt-text-color: {{ section.settings.text_color }};
    --sf-vt-star-color: {{ section.settings.star_color }};
    --sf-vt-play-color: {{ section.settings.play_button_color }};
    --sf-vt-play-icon-color: {{ section.settings.play_icon_color }};
    --sf-vt-progress-background: {{ section.settings.progress_background }};
    --sf-vt-progress-active: {{ section.settings.progress_active }};
    --sf-vt-arrow-background: {{ section.settings.arrow_background }};
    --sf-vt-arrow-border: {{ section.settings.arrow_border }};
    --sf-vt-arrow-color: {{ section.settings.arrow_color }};
    --sf-vt-card-width: {{ section.settings.card_width }}px;
    --sf-vt-card-gap: {{ section.settings.card_gap }}px;
    --sf-vt-image-radius: {{ section.settings.image_border_radius }}px;
    --sf-vt-padding-top: {{ section.settings.padding_top }}px;
    --sf-vt-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="sf-video-testimonials__header">
    {% if section.settings.show_rating %}
      <div class="sf-video-testimonials__rating">
        {% if section.settings.stars != blank %}
          <span
            class="sf-video-testimonials__stars"
            aria-label="{{ section.settings.rating_accessibility_text | escape }}"
          >
            {{ section.settings.stars | escape }}
          </span>
        {% endif %}

        {% if section.settings.rating_text != blank %}
          <span class="sf-video-testimonials__rating-text">
            {{ section.settings.rating_text | escape }}
          </span>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="sf-video-testimonials__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="sf-video-testimonials__description">
        {{ section.settings.description | escape | newline_to_br }}
      </p>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="sf-video-testimonials__slider">
      <div
        class="sf-video-testimonials__track"
        data-sf-video-track
        aria-label="Customer video testimonials"
      >
        {% for block in section.blocks %}
          {% liquid
            assign customer_video = block.settings.video
            assign poster_image = block.settings.poster_image

            if poster_image == blank and customer_video != blank
              assign poster_image = customer_video.preview_image
            endif
          %}

          <article
            class="sf-video-card"
            data-sf-video-card
            {{ block.shopify_attributes }}
          >
            <div class="sf-video-card__media">
              {% if customer_video != blank %}
                <video
                  class="sf-video-card__video"
                  data-sf-video
                  playsinline
                  preload="metadata"
                  {% if poster_image != blank %}
                    poster="{{ poster_image | image_url: width: 800 }}"
                  {% endif %}
                >
                  {% for source in customer_video.sources %}
                    <source src="{{ source.url }}" type="{{ source.mime_type }}">
                  {% endfor %}
                </video>

                <button
                  type="button"
                  class="sf-video-card__play"
                  data-sf-video-play
                  aria-label="Play video testimonial from {{ block.settings.customer_name | default: 'customer' | escape }}"
                >
                  <svg viewBox="0 0 40 40" aria-hidden="true">
                    <circle cx="20" cy="20" r="18"></circle>
                    <path d="M16.5 13.5L27 20L16.5 26.5V13.5Z"></path>
                  </svg>
                </button>

              {% elsif poster_image != blank %}
                {{
                  poster_image
                  | image_url: width: 800
                  | image_tag:
                    class: 'sf-video-card__image',
                    widths: '260, 340, 440, 560, 680, 800',
                    sizes: '(min-width: 750px) 290px, 78vw',
                    loading: 'lazy',
                    alt: block.settings.testimonial_heading
                }}

                <span class="sf-video-card__play sf-video-card__play--static" aria-hidden="true">
                  <svg viewBox="0 0 40 40">
                    <circle cx="20" cy="20" r="18"></circle>
                    <path d="M16.5 13.5L27 20L16.5 26.5V13.5Z"></path>
                  </svg>
                </span>

              {% else %}
                <div class="sf-video-card__placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'sf-video-card__placeholder-svg' }}
                </div>
              {% endif %}
            </div>

            <div class="sf-video-card__content">
              {% if block.settings.testimonial_heading != blank %}
                <h3 class="sf-video-card__heading">
                  {{ block.settings.testimonial_heading | escape }}
                </h3>
              {% endif %}

              {% if block.settings.testimonial_text != blank %}
                <p class="sf-video-card__text">
                  “{{ block.settings.testimonial_text | escape }}”
                </p>
              {% endif %}

              {% if block.settings.customer_name != blank %}
                <p class="sf-video-card__customer-name">
                  {{ block.settings.customer_name | escape }}
                </p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>

      {% if section.settings.show_slider_controls %}
        <div class="sf-video-testimonials__controls" data-sf-video-controls>
          <div class="sf-video-testimonials__progress" aria-hidden="true">
            <span
              class="sf-video-testimonials__progress-thumb"
              data-sf-video-progress
            ></span>
          </div>

          <div class="sf-video-testimonials__arrows">
            <button
              type="button"
              class="sf-video-testimonials__arrow"
              data-sf-video-prev
              aria-label="Previous testimonials"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14.5 5.5L8 12l6.5 6.5M8.5 12H20"></path>
              </svg>
            </button>

            <button
              type="button"
              class="sf-video-testimonials__arrow"
              data-sf-video-next
              aria-label="Next testimonials"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9.5 5.5L16 12l-6.5 6.5M15.5 12H4"></path>
              </svg>
            </button>
          </div>
        </div>
      {% endif %}
    </div>
  {% endif %}
</section>

<style>
  #{{ section_id }} {
    width: 100%;
    overflow: hidden;
    padding: var(--sf-vt-padding-top) 0 var(--sf-vt-padding-bottom);
    background-color: var(--sf-vt-background);
  }

  #{{ section_id }} .sf-video-testimonials__header {
    width: min(calc(100% - 30px), 760px);
    margin: 0 auto {{ section.settings.header_spacing }}px;
    text-align: center;
  }

  #{{ section_id }} .sf-video-testimonials__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    margin-bottom: 7px;
  }

  #{{ section_id }} .sf-video-testimonials__stars {
    color: var(--sf-vt-star-color);
    font-family: Arial, sans-serif;
    font-size: 25px;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 2px;
    line-height: 1;
  }

  #{{ section_id }} .sf-video-testimonials__rating-text {
    color: var(--sf-vt-text-color);
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1;
  }

  #{{ section_id }} .sf-video-testimonials__heading {
    margin: 0;
    color: var(--sf-vt-heading-color, #5C3F2D);
    text-align: center;
    font-family: Lora, Georgia, serif;
    font-size: 32px;
    font-style: normal;
    font-weight: 700;
    line-height: 1.25;
  }

  #{{ section_id }} .sf-video-testimonials__description {
    max-width: 670px;
    margin: 8px auto 0;
    color: var(--sf-vt-text-color, #5C3F2D);
    text-align: center;
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.7;
  }

  #{{ section_id }} .sf-video-testimonials__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: var(--sf-vt-card-width);
    gap: var(--sf-vt-card-gap);
    width: 100%;
    overflow-x: auto;
    padding: 0 clamp(30px, 3.9vw, 56px) 6px;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #{{ section_id }} .sf-video-testimonials__track::-webkit-scrollbar {
    display: none;
  }

  #{{ section_id }} .sf-video-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    scroll-snap-align: start;
  }

  #{{ section_id }} .sf-video-card__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--sf-vt-image-radius);
    background-color: rgba(92, 63, 45, 0.08);
  }

  #{{ section_id }} .sf-video-card__video,
  #{{ section_id }} .sf-video-card__image,
  #{{ section_id }} .sf-video-card__placeholder {
    display: block;
    width: 100%;
    height: {{ section.settings.media_height }}px;
    border-radius: var(--sf-vt-image-radius);
    object-fit: cover;
    object-position: center;
  }

  #{{ section_id }} .sf-video-card__placeholder {
    background-color: rgba(92, 63, 45, 0.06);
  }

  #{{ section_id }} .sf-video-card__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_id }} .sf-video-card__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.play_button_size }}px;
    height: {{ section.settings.play_button_size }}px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--sf-vt-play-color);
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }

  #{{ section_id }} .sf-video-card__play:hover {
    transform: translate(-50%, -50%) scale(1.06);
  }

  #{{ section_id }} .sf-video-card__play svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_id }} .sf-video-card__play circle {
    fill: transparent;
    stroke: currentColor;
    stroke-width: 3;
  }

  #{{ section_id }} .sf-video-card__play path {
    fill: var(--sf-vt-play-icon-color);
    stroke: none;
  }

  #{{ section_id }} .sf-video-card__play--static {
    pointer-events: none;
  }

  #{{ section_id }} .sf-video-card.is-playing .sf-video-card__play {
    opacity: 0;
    pointer-events: none;
  }

  #{{ section_id }} .sf-video-card__content {
    padding: 15px 12px 0;
    text-align: center;
  }

  #{{ section_id }} .sf-video-card__heading {
    margin: 0 0 6px;
    overflow: hidden;
    color: var(--sf-vt-heading-color, #5C3F2D);
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: Lora, Georgia, serif;
    font-size: 17px;
    font-style: italic;
    font-weight: 700;
    line-height: 1.35;
  }

  #{{ section_id }} .sf-video-card__text {
    display: -webkit-box;
    overflow: hidden;
    margin: 0 auto;
    color: var(--sf-vt-text-color, #5C3F2D);
    text-align: center;
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  #{{ section_id }} .sf-video-card__customer-name {
    margin: 7px 0 0;
    color: var(--sf-vt-text-color, #5C3F2D);
    text-align: center;
    font-family: Avenir, "Avenir Next", Arial, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: 1.4;
  }

  #{{ section_id }} .sf-video-testimonials__controls {
    display: flex;
    align-items: center;
    gap: 16px;
    width: min(calc(100% - 30px), {{ section.settings.controls_width }}px);
    margin: {{ section.settings.controls_spacing }}px auto 0;
  }

  #{{ section_id }} .sf-video-testimonials__progress {
    position: relative;
    flex-grow: 1;
    height: {{ section.settings.progress_height }}px;
    overflow: hidden;
    border-radius: 30px;
    background-color: var(--sf-vt-progress-background);
  }

  #{{ section_id }} .sf-video-testimonials__progress-thumb {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 35%;
    height: 100%;
    border-radius: inherit;
    background-color: var(--sf-vt-progress-active);
    transition:
      left 0.15s ease,
      width 0.15s ease;
  }

  #{{ section_id }} .sf-video-testimonials__arrows {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 14px;
  }

  #{{ section_id }} .sf-video-testimonials__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 39px;
    height: 27px;
    padding: 0;
    border: 1px solid var(--sf-vt-arrow-border);
    border-radius: 30px;
    background-color: var(--sf-vt-arrow-background);
    color: var(--sf-vt-arrow-color);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  #{{ section_id }} .sf-video-testimonials__arrow:hover {
    opacity: 0.75;
  }

  #{{ section_id }} .sf-video-testimonials__arrow:disabled {
    cursor: not-allowed;
    opacity: 0.38;
  }

  #{{ section_id }} .sf-video-testimonials__arrow svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media screen and (max-width: 1199px) {
    #{{ section_id }} .sf-video-testimonials__track {
      grid-auto-columns: min(var(--sf-vt-card-width), calc((100vw - 84px) / 3));
      gap: 20px;
      padding-right: 28px;
      padding-left: 28px;
    }

    #{{ section_id }} .sf-video-card__video,
    #{{ section_id }} .sf-video-card__image,
    #{{ section_id }} .sf-video-card__placeholder {
      height: auto;
      aspect-ratio: 0.6 / 1;
    }
  }

  @media screen and (max-width: 899px) {
    #{{ section_id }} .sf-video-testimonials__track {
      grid-auto-columns: calc((100vw - 58px) / 2);
      gap: 14px;
      padding-right: 15px;
      padding-left: 15px;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .sf-video-testimonials__header {
      margin-bottom: 28px;
    }

    #{{ section_id }} .sf-video-testimonials__stars {
      font-size: 21px;
    }

    #{{ section_id }} .sf-video-testimonials__heading {
      font-size: 27px;
      line-height: 1.3;
    }

    #{{ section_id }} .sf-video-testimonials__description {
      margin-top: 8px;
      font-size: 14px;
      line-height: 1.6;
    }

    #{{ section_id }} .sf-video-testimonials__track {
      grid-auto-columns: {{ section.settings.mobile_card_width }}%;
      gap: 14px;
      padding: 0 15px 6px;
    }

    #{{ section_id }} .sf-video-card__video,
    #{{ section_id }} .sf-video-card__image,
    #{{ section_id }} .sf-video-card__placeholder {
      height: auto;
      aspect-ratio: 0.6 / 1;
    }

    #{{ section_id }} .sf-video-card__content {
      padding: 12px 6px 0;
    }

    #{{ section_id }} .sf-video-card__heading {
      font-size: 16px;
    }

    #{{ section_id }} .sf-video-card__text,
    #{{ section_id }} .sf-video-card__customer-name {
      font-size: 13px;
    }

    #{{ section_id }} .sf-video-testimonials__controls {
      gap: 12px;
      margin-top: 30px;
    }

    #{{ section_id }} .sf-video-testimonials__arrows {
      gap: 8px;
    }

    #{{ section_id }} .sf-video-testimonials__arrow {
      width: 37px;
      height: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .sf-video-testimonials__track {
      scroll-behavior: auto;
    }

    #{{ section_id }} .sf-video-card__play,
    #{{ section_id }} .sf-video-testimonials__progress-thumb {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    const sectionId = '{{ section_id }}';

    function initializeVideoTestimonials() {
      const section = document.getElementById(sectionId);

      if (!section || section.dataset.videoTestimonialsInitialized === 'true') {
        return;
      }

      const track = section.querySelector('[data-sf-video-track]');
      const progress = section.querySelector('[data-sf-video-progress]');
      const controls = section.querySelector('[data-sf-video-controls]');
      const previousButton = section.querySelector('[data-sf-video-prev]');
      const nextButton = section.querySelector('[data-sf-video-next]');
      const cards = section.querySelectorAll('[data-sf-video-card]');
      const firstCard = cards[0];

      if (!track || !firstCard) {
        return;
      }

      section.dataset.videoTestimonialsInitialized = 'true';

      function getScrollAmount() {
        const computedStyle = window.getComputedStyle(track);
        const gap = parseFloat(computedStyle.columnGap || computedStyle.gap || 0);

        return firstCard.getBoundingClientRect().width + gap;
      }

      function updateControls() {
        const maximumScroll = track.scrollWidth - track.clientWidth;
        const currentScroll = track.scrollLeft;
        const visibleRatio = track.scrollWidth > 0 ? track.clientWidth / track.scrollWidth : 1;
        const progressWidth = Math.min(100, Math.max(16, visibleRatio * 100));
        const scrollRatio = maximumScroll > 0 ? currentScroll / maximumScroll : 0;
        const progressPosition = scrollRatio * (100 - progressWidth);

        if (progress) {
          progress.style.width = `${progressWidth}%`;
          progress.style.left = `${progressPosition}%`;
        }

        if (previousButton) {
          previousButton.disabled = currentScroll <= 2;
        }

        if (nextButton) {
          nextButton.disabled = currentScroll >= maximumScroll - 2;
        }

        if (controls) {
          controls.style.display = maximumScroll > 2 ? 'flex' : 'none';
        }
      }

      cards.forEach((card) => {
        const video = card.querySelector('[data-sf-video]');
        const playButton = card.querySelector('[data-sf-video-play]');

        if (!video || !playButton) {
          return;
        }

        playButton.addEventListener('click', () => {
          cards.forEach((otherCard) => {
            const otherVideo = otherCard.querySelector('[data-sf-video]');

            if (otherVideo && otherVideo !== video) {
              otherVideo.pause();
              otherVideo.controls = false;
              otherCard.classList.remove('is-playing');
            }
          });

          video.controls = true;
          video.play();
          card.classList.add('is-playing');
        });

        video.addEventListener('pause', () => {
          if (!video.ended) {
            card.classList.remove('is-playing');
          }
        });

        video.addEventListener('ended', () => {
          video.controls = false;
          card.classList.remove('is-playing');
        });
      });

      if (previousButton) {
        previousButton.addEventListener('click', () => {
          track.scrollBy({
            left: -getScrollAmount(),
            behavior: 'smooth'
          });
        });
      }

      if (nextButton) {
        nextButton.addEventListener('click', () => {
          track.scrollBy({
            left: getScrollAmount(),
            behavior: 'smooth'
          });
        });
      }

      track.addEventListener('scroll', updateControls, { passive: true });
      window.addEventListener('resize', updateControls);

      updateControls();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeVideoTestimonials);
    } else {
      initializeVideoTestimonials();
    }

    document.addEventListener('shopify:section:load', function(event) {
      if (
        event.target &&
        (
          event.target.id === sectionId ||
          event.target.querySelector(`#${sectionId}`)
        )
      ) {
        initializeVideoTestimonials();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Slimfair video reviews",
  "tag": "section",
  "class": "section-slimfair-video-testimonials",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Heading content"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating row",
      "default": true
    },
    {
      "type": "text",
      "id": "stars",
      "label": "Stars",
      "default": "★★★★★"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "5.0/5.0"
    },
    {
      "type": "text",
      "id": "rating_accessibility_text",
      "label": "Accessible rating text",
      "default": "Rated 5 out of 5 stars"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Routines. Real Results."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "See how Slimfair Coffee fits into busy mornings, self-care moments and healthy lifestyles supporting weight, digestion, energy and glow."
    },
    {
      "type": "range",
      "id": "header_spacing",
      "label": "Spacing below heading",
      "min": 20,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Section colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F7FBEA"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#5C3F2D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#5C3F2D"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#B7814D"
    },
    {
      "type": "header",
      "content": "Video cards"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Desktop card width",
      "min": 220,
      "max": 380,
      "step": 2,
      "unit": "px",
      "default": 290
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Desktop gap between cards",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 29
    },
    {
      "type": "range",
      "id": "media_height",
