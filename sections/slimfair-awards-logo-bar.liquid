      "step": 1,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "mobile_logo_gap",
      "label": "Mobile gap between logos",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "award_logo",
      "name": "Award logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Award logo"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Logo alt text",
          "default": "Award logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        },
        {
          "type": "range",
          "id": "desktop_logo_width",
          "label": "Desktop logo width",
          "min": 60,
          "max": 240,
          "step": 2,
          "unit": "px",
          "default": 130
        },
        {
          "type": "range",
          "id": "mobile_logo_width",
          "label": "Mobile logo width",
          "min": 60,
          "max": 200,
          "step": 2,
          "unit": "px",
          "default": 112
