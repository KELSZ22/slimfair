<section
  id="SlimfairAwardsLogoBar-{{ section.id }}"
  class="sf-awards-bar"
  style="
    --sf-awards-background: {{ section.settings.background_color }};
    --sf-awards-padding-top: {{ section.settings.padding_top }}px;
    --sf-awards-padding-bottom: {{ section.settings.padding_bottom }}px;
    --sf-awards-gap: {{ section.settings.logo_gap }}px;
    --sf-awards-mobile-gap: {{ section.settings.mobile_logo_gap }}px;
  "
>
  <div class="sf-awards-bar__container">
    {% if section.settings.heading != blank %}
      <h2 class="sf-awards-bar__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        class="sf-awards-bar__logos{% if section.settings.enable_mobile_scroll %} sf-awards-bar__logos--mobile-scroll{% endif %}"
        aria-label="{{ section.settings.accessibility_label | escape }}"
      >
        {% for block in section.blocks %}
          <div
            class="sf-awards-bar__item"
            style="
              --sf-award-logo-width: {{ block.settings.desktop_logo_width }}px;
              --sf-award-logo-width-mobile: {{ block.settings.mobile_logo_width }}px;
            "
            {{ block.shopify_attributes }}
          >
            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                class="sf-awards-bar__link"
                {% if block.settings.open_in_new_tab %}
                  target="_blank"
                  rel="noopener noreferrer"
                {% endif %}
                aria-label="{{ block.settings.label | default: 'View award' | escape }}"
              >
            {% endif %}

            {% if block.settings.logo != blank %}
              {{
                block.settings.logo
                | image_url: width: 500
                | image_tag:
                  class: 'sf-awards-bar__logo',
                  widths: '100, 150, 200, 250, 300, 400, 500',
                  sizes: '(max-width: 749px) 120px, 180px',
                  loading: 'lazy',
                  alt: block.settings.label
              }}
            {% else %}
              <div class="sf-awards-bar__placeholder">
                {{ 'image' | placeholder_svg_tag: 'sf-awards-bar__placeholder-svg' }}
              </div>
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #SlimfairAwardsLogoBar-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    padding: var(--sf-awards-padding-top) 40px var(--sf-awards-padding-bottom);
    background-color: var(--sf-awards-background);
  }

  #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__container {
    width: 100%;
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
  }

  #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__heading {
    margin: 0 0 30px;
    color: {{ section.settings.heading_color }};
    text-align: center;
    font-family: Lora, Georgia, serif;
    font-size: 32px;
    font-style: normal;
    font-weight: 700;
    line-height: 1.25;
  }

  #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sf-awards-gap);
    width: 100%;
  }

  #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__item {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: var(--sf-award-logo-width);
  }

  #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    text-decoration: none;
  }

  #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__logo {
    display: block;
    width: 100%;
    max-width: var(--sf-award-logo-width);
    height: {{ section.settings.logo_height }}px;
    object-fit: contain;
    object-position: center;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__link:hover .sf-awards-bar__logo {
    opacity: 0.85;
    transform: translateY(-2px);
  }

  #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: {{ section.settings.logo_height }}px;
    opacity: 0.35;
  }

  #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 1199px) {
    #SlimfairAwardsLogoBar-{{ section.id }} {
      padding-right: 28px;
      padding-left: 28px;
    }

    #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__logos {
      gap: clamp(22px, 3.2vw, var(--sf-awards-gap));
    }

    #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__logo {
      height: {{ section.settings.tablet_logo_height }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #SlimfairAwardsLogoBar-{{ section.id }} {
      padding: {{ section.settings.mobile_padding_top }}px 15px {{ section.settings.mobile_padding_bottom }}px;
    }

    #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__heading {
      margin-bottom: 24px;
      font-size: 27px;
      line-height: 1.3;
    }

    #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__logos {
      gap: var(--sf-awards-mobile-gap);
    }

    #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__logos--mobile-scroll {
      justify-content: flex-start;
      overflow-x: auto;
      padding: 0 0 6px;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__logos--mobile-scroll::-webkit-scrollbar {
      display: none;
    }

    #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__item {
      width: var(--sf-award-logo-width-mobile);
      scroll-snap-align: start;
    }

    #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__logo {
      max-width: var(--sf-award-logo-width-mobile);
      height: {{ section.settings.mobile_logo_height }}px;
    }

    #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__placeholder {
      height: {{ section.settings.mobile_logo_height }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__logo {
      transition: none;
    }

    #SlimfairAwardsLogoBar-{{ section.id }} .sf-awards-bar__link:hover .sf-awards-bar__logo {
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "Slimfair awards logo bar",
  "tag": "section",
  "class": "section-slimfair-awards-logo-bar",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Optional heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to display only the award logos, like the reference image."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFF8E8"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#634532"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Maximum content width",
      "min": 900,
      "max": 1600,
      "step": 10,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Awards and recognitions"
    },
    {
      "type": "header",
      "content": "Logo layout"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Desktop logo height",
      "min": 40,
