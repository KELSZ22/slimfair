{% assign section_id = section.id %}
{% assign background_image = section.settings.background_image %}
{% assign has_background_image = false %}
{% if background_image != blank %}
  {% assign has_background_image = true %}
{% endif %}

<section class="custom-ingredient-benefits custom-ingredient-benefits--{{ section_id }}{% if has_background_image %} custom-ingredient-benefits--has-bg-image{% endif %}" style="
    --ingredient-benefits-bg: {{ section.settings.background_color }};
    --ingredient-benefits-text: {{ section.settings.text_color }};
    --ingredient-benefits-heading: {{ section.settings.heading_color }};
    --ingredient-benefits-accent: {{ section.settings.accent_color }};
    --ingredient-benefits-card-bg: {{ section.settings.card_background_color }};
    --ingredient-benefits-card-border: {{ section.settings.card_border_color }};
    --ingredient-benefits-featured-bg: {{ section.settings.featured_card_background_color }};
    --ingredient-benefits-featured-text: {{ section.settings.featured_card_text_color }};
    --ingredient-benefits-overlay-opacity: {{ section.settings.background_overlay_opacity | divided_by: 100.0 }};
    --ingredient-benefits-margin-top: {{ section.settings.margin_top }}px;
    --ingredient-benefits-margin-bottom: {{ section.settings.margin_bottom }}px;
  ">
  {% if has_background_image %}
    <div
      class="custom-ingredient-benefits__background"
      aria-hidden="true"
      style="
        background-image: url('{{ background_image | img_url: '2400x' }}');
        background-position: {{ section.settings.background_image_position }};
        background-size: {{ section.settings.background_image_size }};
      ">
</div>
    {% if section.settings.background_overlay_opacity > 0 %}
      <div
        class="custom-ingredient-benefits__overlay"
        aria-hidden="true"
        style="background-color: {{ section.settings.background_overlay_color }};"></div>
    {% endif %}
  {% endif %}

  <div class="custom-ingredient-benefits__inner page-width">
    <div class="custom-ingredient-benefits__header">
      {% if section.settings.rating_text != blank %}
        <div class="custom-ingredient-benefits__rating" aria-label="{{ section.settings.rating_text | escape }}">
          <span class="custom-ingredient-benefits__stars" aria-hidden="true">
            {% for i in (1..5) %}
              <span>★</span>
            {% endfor %}
          </span>
          <span>{{ section.settings.rating_text | escape }}</span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="custom-ingredient-benefits__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="custom-ingredient-benefits__subheading rte-setting">{{ section.settings.subheading }}</div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="custom-ingredient-benefits__grid">
        {% for block in section.blocks %}
          <article class="custom-ingredient-benefits__card{% if block.settings.image == blank %} custom-ingredient-benefits__card--no-image{% endif %}" {{ block.shopify_attributes }}>
            <div class="custom-ingredient-benefits__card-copy">
              {% if block.settings.eyebrow != blank %}
                <p class="custom-ingredient-benefits__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {% endif %}

              {% if block.settings.title != blank %}
                <h3 class="custom-ingredient-benefits__card-title">{{ block.settings.title | escape }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="custom-ingredient-benefits__description rte-setting">{{ block.settings.description }}</div>
              {% endif %}
            </div>

            {% if block.settings.image != blank %}
              <div class="custom-ingredient-benefits__image custom-ingredient-benefits__image--{{ block.settings.image_position }}">
                <img
                  src="{{ block.settings.image | img_url: '240x240' }}"
                  srcset="
                    {{ block.settings.image | img_url: '120x120' }} 120w,
                    {{ block.settings.image | img_url: '180x180' }} 180w,
                    {{ block.settings.image | img_url: '240x240' }} 240w
                  "
                  sizes="(min-width: 990px) 120px, 96px"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy">
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    padding-bottom: 0;
    padding-top: 0;
  }

  .custom-ingredient-benefits {
    background-color: var(--ingredient-benefits-bg);
    color: var(--ingredient-benefits-text);
    margin-bottom: var(--ingredient-benefits-margin-bottom);
    margin-top: var(--ingredient-benefits-margin-top);
    overflow: hidden;
    padding: 56px 0 0;
    position: relative;
  }

  .custom-ingredient-benefits__background,
  .custom-ingredient-benefits__overlay {
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .custom-ingredient-benefits__background {
    background-repeat: no-repeat;
    z-index: 0;
  }

  .custom-ingredient-benefits__overlay {
    opacity: var(--ingredient-benefits-overlay-opacity);
    z-index: 1;
  }

  .custom-ingredient-benefits__inner.page-width {
    max-width: 1360px;
    width: 100%;
    padding-bottom: 25px;
  }

  .custom-ingredient-benefits__inner {
    position: relative;
    z-index: 2;
  }

  .custom-ingredient-benefits__header {
    margin: 0 auto 28px;
    text-align: center;
  }

  .custom-ingredient-benefits__rating {
    align-items: center;
    color: #0A0A0A;
    display: flex;
    font-size: 16px;
    gap: 7px;
    justify-content: center;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .custom-ingredient-benefits__stars {
    color: #B68353;
    display: inline-flex;
    font-size: 24px;
    gap: 2px;
    letter-spacing: 0;
    line-height: 1;
  }

  .custom-ingredient-benefits__heading {
    font-family: Lora;
    font-size: 40px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    color: #5C3F2D;
    margin: 0;
    text-transform: none;
    letter-spacing: 0;
  }

  .custom-ingredient-benefits__subheading,
  .custom-ingredient-benefits__subheading.rte-setting {
    color: var(--ingredient-benefits-text);
    font-size: 18px;
    line-height: 1.55;
    margin: 12px auto 0;
    max-width: 720px;
  }

  .custom-ingredient-benefits__subheading p,
  .custom-ingredient-benefits__subheading.rte-setting p {
    color: var(--ingredient-benefits-text);
    margin: 0;
  }

  .custom-ingredient-benefits__description p {
    margin: 0;
  }

  .custom-ingredient-benefits__grid {
    --ingredient-card-width: 328px;
    --ingredient-grid-gap: 12px;
    display: grid;
    gap: 17px;
    grid-template-columns: repeat(4, var(--ingredient-card-width));
    justify-content: center;
  }

  .custom-ingredient-benefits__card {
    background: var(--ingredient-benefits-card-bg);
    border: 1px solid var(--ingredient-benefits-card-border);
    border-radius: 8px;
    box-sizing: border-box;
    color: var(--ingredient-benefits-text);
    display: flex;
    min-height: 148px;
    overflow: hidden;
    padding: 25px;
    position: relative;
    transition: background-color 0.2s ease
    , border-color 0.2s ease
    , color 0.2s ease;
    width: 328px;
    max-width: 100%;
  }

  @media (hover: hover) {
    .custom-ingredient-benefits__card:hover {
      background: var(--ingredient-benefits-featured-bg);
      color: var(--ingredient-benefits-featured-text);
    }
  }

  .custom-ingredient-benefits__card-copy {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    max-width: 65%;
    min-width: 0;
    position: relative;
    z-index: 1;
  }

  .custom-ingredient-benefits__card--no-image .custom-ingredient-benefits__card-copy {
    max-width: 100%;
  }

  .custom-ingredient-benefits__eyebrow {
    color: inherit;
    font-size: 14px;
    line-height: 1.25;
    margin: 0 0 7px;
    opacity: .9;
  }

  .custom-ingredient-benefits__card-title {
    color: inherit;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.18;
    margin: 0 0 10px;
    text-transform: uppercase;
    font-family: "Avenir-Black"
    , Avenir
    , "Avenir Next"
    , sans-serif !important;
    letter-spacing: 0;
    text-transform: none;
  }

  .custom-ingredient-benefits__description,
  .custom-ingredient-benefits__description.rte-setting {
    color: inherit;
    font-size: 14px;
    line-height: 1.45;
    opacity: .9;
  }

  .custom-ingredient-benefits__description p {
    color: inherit;
    font-size: inherit;
  }

  .custom-ingredient-benefits__image {
    bottom: 0;
    pointer-events: none;
    position: absolute;
    right: 0;
    top: 0;
    width: 40%;
  }

  .custom-ingredient-benefits__image img {
    height: 100%;
    object-fit: cover;
    object-position: center;
    width: 100%;
  }

  .custom-ingredient-benefits__image--contain img {
    object-fit: contain;
    padding: 5px;
  }

  .custom-ingredient-benefits__image--cover img {
    object-fit: cover;
  }

  @media screen and (max-width: 989px) {
    .custom-ingredient-benefits {
      padding: 44px 0 0;
    }

    .custom-ingredient-benefits__grid {
      grid-template-columns: repeat(2, var(--ingredient-card-width));
    }
  }

  @media screen and (max-width: 589px) {
    .custom-ingredient-benefits {
      padding: 36px 0 0;
    }

    .custom-ingredient-benefits__header {
      margin-bottom: 22px;
    }

    .custom-ingredient-benefits__rating {
      font-size: 14px;
    }

    .custom-ingredient-benefits__heading {
      font-size: 24px;
    }

    .custom-ingredient-benefits__subheading,
    .custom-ingredient-benefits__subheading.rte-setting {
      font-size: 16px;
    }

    .custom-ingredient-benefits__eyebrow {
      font-size: 12px;
    }

    .custom-ingredient-benefits__card-title {
      font-size: 16px;
    }

    .custom-ingredient-benefits__description,
    .custom-ingredient-benefits__description.rte-setting {
      font-size: 12px;
    }

    .custom-ingredient-benefits__grid {
      grid-template-columns: 1fr;
    }

    .custom-ingredient-benefits__card {
      min-height: 132px;
      width: 100%;
    }

    .custom-ingredient-benefits__subheading p,
    .custom-ingredient-benefits__subheading.rte-setting p {
      font-size: 16px;
      text-align: justify;
    }
  }
</style>

{% schema %}
  {
    "name": "Ingredient benefits",
    "class": "index-section",
    "settings": [
      {
        "type": "text",
        "id": "rating_text",
        "label": "Rating text",
        "default": "Rated by 20,000+ Coffee Lovers"
