        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 0
      }, {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#6F3F25"
      }, {
        "type": "color",
        "id": "text_color",
