        "id": "subheading",
        "label": "Subheading",
        "default": "<p>Every ingredient is carefully selected to support fat loss, boost metabolism, and keep you feeling in control, nothing unnecessary, nothing hidden.</p>"
      },
      {
        "type": "header",
        "content": "Spacing"
      }, {
        "type": "range",
        "id": "margin_top",
        "label": "Top margin",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 0
      }, {
        "type": "range",
        "id": "margin_bottom",
        "label": "Bottom margin",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 0
      }, {
        "type": "header",
        "content": "Background"
      }, {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
      }, {
        "type": "select",
        "id": "background_image_position",
        "label": "Image position",
        "default": "center center",
        "options": [
          {
            "value": "top left",
            "label": "Top left"
          },
          {
            "value": "top center",
            "label": "Top center"
          },
          {
            "value": "top right",
            "label": "Top right"
          },
          {
            "value": "center left",
            "label": "Center left"
          }, {
            "value": "center center",
            "label": "Center"
          }, {
            "value": "center right",
            "label": "Center right"
          }, {
            "value": "bottom left",
            "label": "Bottom left"
          }, {
            "value": "bottom center",
            "label": "Bottom center"
          }, {
            "value": "bottom right",
            "label": "Bottom right"
          }
        ]
      }, {
        "type": "select",
        "id": "background_image_size",
        "label": "Image size",
        "default": "cover",
        "options": [
          {
            "value": "cover",
            "label": "Cover"
          }, {
            "value": "contain",
            "label": "Contain"
          }, {
            "value": "auto",
            "label": "Original"
