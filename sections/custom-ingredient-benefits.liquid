        "id": "featured_card_text_color",
        "label": "Card hover text color",
        "default": "#FFFFFF"
      }
    ],
    "blocks": [
      {
        "type": "ingredient",
        "name": "Ingredient card",
        "settings": [
          {
            "type": "text",
