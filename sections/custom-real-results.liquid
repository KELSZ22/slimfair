<section
  class="custom-real-results"
  data-real-results-id="{{ section.id }}"
  style="
    --real-results-bg: {{ section.settings.background_color }};
    --real-results-heading: {{ section.settings.heading_color }};
    --real-results-text: {{ section.settings.text_color }};
    --real-results-accent: {{ section.settings.accent_color }};
    --real-results-line: {{ section.settings.line_color }};
    --real-results-padding-top: {{ section.settings.padding_top }}px;
    --real-results-padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="custom-real-results__inner page-width">
    <div class="custom-real-results__header">
      {% if section.settings.rating_text != blank %}
        <div class="custom-real-results__rating" aria-label="{{ section.settings.rating_text | escape }}">
          <span class="custom-real-results__stars" aria-hidden="true">
            {% for i in (1..5) %}
              <span>★</span>
            {% endfor %}
          </span>
          <span>{{ section.settings.rating_text | escape }}</span>
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="custom-real-results__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="custom-real-results__text rte-setting">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="custom-real-results__viewport">
        <div class="custom-real-results__track" data-real-results-track>
          {% for block in section.blocks %}
            {% assign hosted_video_url = blank %}

            {% if block.settings.hosted_video != blank %}
              {% for source in block.settings.hosted_video.sources %}
                {% if hosted_video_url == blank and source.format == 'mp4' %}
                  {% assign hosted_video_url = source.url %}
                {% endif %}
              {% endfor %}

              {% if hosted_video_url == blank and block.settings.hosted_video.sources.size > 0 %}
                {% assign hosted_video_url = block.settings.hosted_video.sources[0].url %}
              {% endif %}
            {% endif %}

            {% assign video_url = hosted_video_url | default: block.settings.video_url %}

            <article class="custom-real-results__card" {{ block.shopify_attributes }}>
              {% capture card_media %}
                {% if block.settings.image != blank %}
                  <img
                    class="custom-real-results__image"
                    src="{{ block.settings.image | img_url: '420x640', crop: 'center' }}"
                    alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                    loading="lazy"
                    width="420"
                    height="640">
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg custom-real-results__placeholder' }}
                {% endif %}

                <span class="custom-real-results__shade" aria-hidden="true"></span>

                {% if block.settings.overlay_quote != blank %}
                  <span class="custom-real-results__overlay-quote">{{ block.settings.overlay_quote | escape }}</span>
                {% endif %}

                {% if video_url != blank %}
                  <span class="custom-real-results__play" aria-hidden="true"></span>
                {% endif %}
              {% endcapture %}
              {% if video_url != blank %}
                <button
                  type="button"
                  class="custom-real-results__media"
                  data-real-results-video-trigger
                  data-video-url="{{ video_url | escape }}"
                  aria-label="Play {{ block.settings.title | default: section.settings.heading | escape }}">
                  {{ card_media }}
                </button>
              {% else %}
                <div class="custom-real-results__media">
                  {{ card_media }}
                </div>
              {% endif %}

              {% if block.settings.title != blank %}
                <h3 class="custom-real-results__card-title">{{ block.settings.title | escape }}</h3>
              {% endif %}

              {% if block.settings.quote != blank %}
                <div class="custom-real-results__quote rte-setting">{{ block.settings.quote }}</div>
              {% endif %}

              {% if block.settings.name != blank %}
                <p class="custom-real-results__name">{{ block.settings.name | escape }}</p>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </div>

      <div class="custom-real-results__controls">
        <button
          type="button"
          class="custom-real-results__controls-line"
          data-real-results-scrollbar
          aria-label="Scroll results">
          <span class="custom-real-results__controls-progress" data-real-results-scrollbar-progress></span>
          <span class="custom-real-results__controls-thumb" data-real-results-scrollbar-thumb></span>
        </button>
        <div class="custom-real-results__controls-arrows">
          <button
            type="button"
            class="custom-real-results__arrow"
            data-real-results-prev
            aria-label="Scroll results left">
            <img
              src="{{ 'arrow-left-yellow.png' | asset_url }}"
              alt=""
              aria-hidden="true"
              loading="lazy"
              width="39"
              height="25">
          </button>
          <button
            type="button"
            class="custom-real-results__arrow"
            data-real-results-next
            aria-label="Scroll results right">
            <img
              src="{{ 'arrow-right.svg' | asset_url }}"
              alt=""
              aria-hidden="true"
              loading="lazy"
              width="39"
              height="25">
          </button>
        </div>
      </div>
    {% endif %}
  </div>

  <div
    class="custom-real-results__modal"
    data-real-results-modal
    hidden
    aria-hidden="true">
    <button
      type="button"
      class="custom-real-results__backdrop"
      data-real-results-close
      aria-label="Close video"></button>
    <div
      class="custom-real-results__dialog"
      role="dialog"
      aria-modal="true"
      aria-label="{{ section.settings.heading | default: 'Results video' | escape }}">
      <button
        type="button"
        class="custom-real-results__close"
        data-real-results-close
        aria-label="Close video">
        {% include 'icon-close' %}
      </button>
      <div class="custom-real-results__player" data-real-results-player></div>
    </div>
  </div>
</section>

<style>
  .custom-real-results {
    background: var(--real-results-bg);
    color: var(--real-results-text);
    overflow: hidden;
    padding: var(--real-results-padding-top) 0 var(--real-results-padding-bottom);
  }

  .custom-real-results__inner.page-width {
    max-width: 1160px;
  }

  .custom-real-results__header {
    margin: 0 auto 34px;
    max-width: 720px;
    text-align: center;
  }

  .custom-real-results__rating {
    align-items: center;
    color: var(--real-results-text);
    display: inline-flex;
    font-size: 16px;
    gap: 8px;
    line-height: 1.1;
    margin-bottom: 4px;
  }

  .custom-real-results__stars {
    color: var(--real-results-accent);
    display: inline-flex;
    font-size: 24px;
    gap: 1px;
    letter-spacing: 0;
  }

  .custom-real-results__heading {
    color: var(--real-results-heading);
    font-family: Lora
    , serif;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.18;
    margin: 0 0 8px;
  }

  .custom-real-results__text,
  .custom-real-results__text.rte-setting {
    color: var(--real-results-text);
    font-size: 18px;
    line-height: 1.5;
    margin: 0 auto;
    max-width: 670px;
  }

  .custom-real-results__text p,
  .custom-real-results__quote p {
    color: inherit;
    margin: 0;
  }

  .custom-real-results__viewport {
    overflow: visible;
    width: calc(100% + max(0px, (100vw - min(100vw, 1160px)) / 2));
  }

  .custom-real-results__track {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    padding: 0 0 18px;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .custom-real-results__track::-webkit-scrollbar {
    display: none;
  }

  .custom-real-results__card {
    flex: 0 0 230px;
    scroll-snap-align: start;
    text-align: center;
  }

  .custom-real-results__media {
    background: transparent;
    border: 0;
    border-radius: 8px;
    display: block;
    margin: 0;
    overflow: hidden;
    padding: 0;
    position: relative;
    width: 100%;
  }

  .custom-real-results__image,
  .custom-real-results__placeholder {
    aspect-ratio: 230 / 352;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .custom-real-results__placeholder {
    background: #eadfc6;
  }

  .custom-real-results__shade {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1) 45%, rgba(0, 0, 0, 0.22));
    inset: 0;
    position: absolute;
  }

  .custom-real-results__overlay-quote {
    color: #fff;
    font-size: 11px;
    font-style: italic;
    left: 18px;
    line-height: 1.25;
    position: absolute;
    right: 18px;
    text-align: center;
    top: 38px;
  }

  .custom-real-results__play {
    border: 3px solid #fff;
    border-radius: 50%;
    height: 45px;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 45px;
  }

  .custom-real-results__play:after {
    border-bottom: 10px solid transparent;
    border-left: 15px solid #fff;
    border-top: 10px solid transparent;
    content: "";
    left: 17px;
    position: absolute;
    top: 10px;
  }

  .custom-real-results__card-title {
    color: var(--real-results-heading);
    font-family: Lora
    , serif;
    font-size: 18px;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.25;
    margin: 14px 0 4px;
  }

  .custom-real-results__quote,
  .custom-real-results__quote.rte-setting {
    color: var(--real-results-text);
    font-size: 14px;
    line-height: 1.45;
  }

  .custom-real-results__name {
    color: var(--real-results-heading);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.25;
    margin: 8px 0 0;
  }

  .custom-real-results__controls {
    align-items: center;
    display: flex;
    gap: 16px;
    margin: 24px auto 0;
    max-width: 100%;
    width: 100%;
  }

  .custom-real-results__controls-line {
    background: #d6cc76;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    flex: 1 1 auto;
    height: 4px;
    min-width: 0;
    padding: 0;
    position: relative;
  }

  .custom-real-results__controls-line:focus-visible {
    outline: 2px solid var(--real-results-line);
    outline-offset: 2px;
  }

  .custom-real-results__controls-progress {
    background: var(--real-results-line);
    border-radius: 999px;
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    width: 0;
  }

  .custom-real-results__controls-thumb {
    background: #eadba0;
    border: 1px solid #a77a33;
    border-radius: 999px;
    display: none;
    height: 14px;
    left: 0;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 14px;
  }

  .custom-real-results__controls-arrows {
    display: inline-flex;
    gap: 8px;
  }

  .custom-real-results__arrow {
    align-items: center;
    background: transparent;
    border: 0;
    display: inline-flex;
    height: 25px;
    justify-content: center;
    margin-top: 0;
    padding: 0;
    position: relative;
    width: 39px;
    z-index: 1;
  }

  .custom-real-results__arrow img {
    display: block;
    height: 100%;
    width: 100%;
  }

  .custom-real-results__modal[hidden] {
    display: none !important;
    pointer-events: none;
  }

  .custom-real-results__modal:not([hidden]) {
    box-sizing: border-box;
    display: grid;
    inset: 0;
    padding: max(16px, env(safe-area-inset-top, 0px))
      max(16px, env(safe-area-inset-right, 0px))
      max(16px, env(safe-area-inset-bottom, 0px))
      max(16px, env(safe-area-inset-left, 0px));
    place-items: center;
    position: fixed;
    z-index: 9999;
  }

  .custom-real-results__backdrop {
    background: rgba(0, 0, 0, 0.72);
    border: 0;
    inset: 0;
    position: absolute;
  }

  .custom-real-results__dialog {
    align-items: center;
    background: #111;
    border-radius: 8px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.38);
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0;
    max-height: calc(100dvh - 32px);
    max-height: calc(100vh - 32px);
    position: relative;
    width: min(96vw, 1180px);
    z-index: 1;
  }

  .custom-real-results__close {
    align-items: center;
    background: rgba(0, 0, 0, 0.48);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 50%;
    color: #fff;
    display: flex;
    height: 34px;
    justify-content: center;
    padding: 0;
    position: absolute;
    right: 8px;
    top: 8px;
    width: 34px;
    z-index: 2;
  }

  .custom-real-results__close svg {
    display: block;
    height: 14px;
    width: 14px;
  }

  .custom-real-results__player {
    aspect-ratio: 16 / 9;
    background: #111;
    border-radius: 8px;
    max-height: calc(100dvh - 32px);
    max-height: calc(100vh - 32px);
    overflow: hidden;
    width: min(100%, 1180px, calc((100dvh - 32px) * 16 / 9), calc((100vh - 32px) * 16 / 9));
  }

  .custom-real-results__player iframe,
  .custom-real-results__player video {
    border: 0;
    display: block;
    height: 100%;
    width: 100%;
  }

  .custom-real-results-open {
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    .custom-real-results {
      padding: 24px 0 28px;
    }

    .custom-real-results__inner.page-width {
      padding-left: 16px;
      padding-right: 0;
    }

    .custom-real-results__header {
      margin: 0 11px 16px 0;
      max-width: none;
    }

    .custom-real-results__rating {
      font-size: 16px;
      gap: 6px;
      margin-bottom: 3px;
    }

    .custom-real-results__stars {
      font-size: 20px;
      gap: 0;
    }

    .custom-real-results__heading {
      font-size: 24px;
      line-height: 1.15;
      margin-bottom: 8px;
    }

    .custom-real-results__text,
    .custom-real-results__text.rte-setting {
      font-size: 16px;
      line-height: 1.5;
      max-width: none;
      width: 100%;
    }

    .custom-real-results__viewport {
      overflow: visible;
      width: 100%;
    }

    .custom-real-results__track {
      gap: 12px;
      padding: 0 0 12px;
      scroll-padding-left: 0;
    }

    .custom-real-results__card {
      flex: 0 0 min(230px, calc(100vw - 79px));
    }

    .custom-real-results__media {
      border-radius: 8px;
    }

    .custom-real-results__image,
    .custom-real-results__placeholder {
      aspect-ratio: 230 / 352;
    }

    .custom-real-results__overlay-quote {
      font-size: 10px;
      left: 14px;
      right: 14px;
      top: 12px;
    }

    .custom-real-results__play {
      height: 56px;
      width: 56px;
    }

    .custom-real-results__play:after {
      border-bottom-width: 12px;
      border-left-width: 18px;
      border-top-width: 12px;
      left: 21px;
      top: 13px;
    }

    .custom-real-results__card-title {
      font-size: 18px;
      line-height: 1.2;
      margin: 14px 6px 6px;
    }

    .custom-real-results__quote,
    .custom-real-results__quote.rte-setting {
      font-size: 14px;
      line-height: 1.45;
      margin: 0 6px;
      width: 100%;
    }

    .custom-real-results__name {
      font-size: 14px;
      margin-top: 8px;
    }

    .custom-real-results__controls {
      gap: 12px;
      margin: 10px auto 0;
      padding-right: 16px;
      width: 100%;
    }

    .custom-real-results__controls-line {
      height: 3px;
    }

    .custom-real-results__controls-thumb {
      height: 12px;
      width: 12px;
    }

    .custom-real-results__controls-arrows {
      gap: 6px;
    }

    .custom-real-results__arrow {
      height: 20px;
      margin-top: 0;
      width: 31px;
    }

    .custom-real-results__dialog {
      width: min(96vw, 430px);
    }

    .custom-real-results__player {
      aspect-ratio: 9 / 16;
      max-height: calc(100dvh - 32px);
      max-height: calc(100vh - 32px);
      width: min(96vw, 430px, calc((100dvh - 32px) * 9 / 16), calc((100vh - 32px) * 9 / 16));
    }
  }
</style>

<script>
  (function() {
    var section = document.querySelector('[data-real-results-id="{{ section.id }}"]');
    if (!section) return;

    var track = section.querySelector('[data-real-results-track]');
    var prev = section.querySelector('[data-real-results-prev]');
    var next = section.querySelector('[data-real-results-next]');
    var scrollbar = section.querySelector('[data-real-results-scrollbar]');
    var scrollbarProgress = section.querySelector('[data-real-results-scrollbar-progress]');
    var scrollbarThumb = section.querySelector('[data-real-results-scrollbar-thumb]');
    var modal = section.querySelector('[data-real-results-modal]');
    var player = section.querySelector('[data-real-results-player]');
    var activeTrigger = null;
    var isDraggingScrollbar = false;

    function getCardPositions() {
      if (!track) return [];
      var cards = track.querySelectorAll('.custom-real-results__card');
      return Array.prototype.map.call(cards, function(card) {
        return card.offsetLeft - track.offsetLeft;
      });
    }

    function scrollByCard(direction) {
      if (!track) return;
      var positions = getCardPositions();
      if (!positions.length) return;

      var current = track.scrollLeft;
      var target = positions[0];
      var tolerance = 4;

      if (direction > 0) {
        target = positions[positions.length - 1];
        for (var i = 0; i < positions.length; i++) {
          if (positions[i] > current + tolerance) {
            target = positions[i];
            break;
          }
        }
      } else {
        for (var j = positions.length - 1; j >= 0; j--) {
          if (positions[j] < current - tolerance) {
            target = positions[j];
            break;
          }
        }
      }

      track.scrollTo({ left: target, behavior: 'smooth' });
    }

    function updateScrollbar() {
      if (!track || !scrollbar || !scrollbarProgress || !scrollbarThumb) return;

      var maxScroll = track.scrollWidth - track.clientWidth;
      var ratio = maxScroll > 0 ? Math.min(1, Math.max(0, track.scrollLeft / maxScroll)) : 0;

      scrollbarProgress.style.width = ratio * 100 + '%';
      scrollbarThumb.style.left = ratio * 100 + '%';
      scrollbar.disabled = maxScroll <= 0;
    }

    function scrollToRatio(ratio) {
      if (!track) return;
      var maxScroll = track.scrollWidth - track.clientWidth;
      var clampedRatio = Math.min(1, Math.max(0, ratio));
      track.scrollTo({ left: maxScroll * clampedRatio, behavior: 'auto' });
    }

    function getPointerRatio(event) {
      if (!scrollbar) return 0;
      var rect = scrollbar.getBoundingClientRect();
      if (!rect.width) return 0;
      return (event.clientX - rect.left) / rect.width;
    }

    function onScrollbarPointerDown(event) {
      if (!scrollbar || scrollbar.disabled) return;
      isDraggingScrollbar = true;
      scrollbar.setPointerCapture(event.pointerId);
      scrollToRatio(getPointerRatio(event));
      event.preventDefault();
    }

    function onScrollbarPointerMove(event) {
      if (!isDraggingScrollbar) return;
      scrollToRatio(getPointerRatio(event));
      event.preventDefault();
    }

    function onScrollbarPointerUp(event) {
      if (!scrollbar) return;
      isDraggingScrollbar = false;
      if (scrollbar.hasPointerCapture(event.pointerId)) {
        scrollbar.releasePointerCapture(event.pointerId);
      }
    }

    function getEmbedUrl(url) {
      url = url.replace(/&amp;/g, '&');
      var youtubeMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/shorts\/)([^&?/#]+)/);
      var vimeoMatch = url.match(/vimeo\.com\/(?:video\/)?([0-9]+)/);

      if (youtubeMatch && youtubeMatch[1]) return 'https://www.youtube.com/embed/' + youtubeMatch[1] + '?autoplay=1&rel=0';
      if (vimeoMatch && vimeoMatch[1]) return 'https://player.vimeo.com/video/' + vimeoMatch[1] + '?autoplay=1';
      return url;
    }

    function isVideoFile(url) {
      return /\.(mp4|webm|ogg|mov)(\?.*)?$/i.test(url);
    }

    function ensureModalInBody() {
      if (modal && modal.parentElement !== document.body) {
        document.body.appendChild(modal);
      }
    }

    function openVideo(url, trigger) {
      if (!modal || !player) return;
      ensureModalInBody();
      activeTrigger = trigger;
      player.innerHTML = '';

      if (isVideoFile(url)) {
        var video = document.createElement('video');
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.src = url;
        player.appendChild(video);
      } else {
        var iframe = document.createElement('iframe');
        iframe.src = getEmbedUrl(url);
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        iframe.title = trigger.getAttribute('aria-label') || 'Results video';
        player.appendChild(iframe);
      }

      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('custom-real-results-open');

      var closeButton = modal.querySelector('.custom-real-results__close');
      if (closeButton) closeButton.focus();
    }

    function closeVideo() {
      if (!modal || !player) return;
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      player.innerHTML = '';
      document.documentElement.classList.remove('custom-real-results-open');
      if (activeTrigger) activeTrigger.focus();
      activeTrigger = null;
    }

    if (prev) prev.addEventListener('click', function() { scrollByCard(-1); });
    if (next) next.addEventListener('click', function() { scrollByCard(1); });
    if (scrollbar) {
      scrollbar.addEventListener('pointerdown', onScrollbarPointerDown);
      scrollbar.addEventListener('pointermove', onScrollbarPointerMove);
      scrollbar.addEventListener('pointerup', onScrollbarPointerUp);
      scrollbar.addEventListener('pointercancel', onScrollbarPointerUp);
      scrollbar.addEventListener('lostpointercapture', function() {
        isDraggingScrollbar = false;
      });
    }
    if (track) track.addEventListener('scroll', updateScrollbar);
    window.addEventListener('resize', updateScrollbar);
    updateScrollbar();
    ensureModalInBody();

    section.addEventListener('click', function(event) {
      var trigger = event.target.closest('[data-real-results-video-trigger]');
      if (trigger) openVideo(trigger.getAttribute('data-video-url'), trigger);

      if (event.target.closest('[data-real-results-close]')) closeVideo();
    });

    document.addEventListener('click', function(event) {
      if (modal && modal.contains(event.target) && event.target.closest('[data-real-results-close]')) {
        event.preventDefault();
        closeVideo();
      }
    });

    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape' && modal && !modal.hidden) closeVideo();
    });
  })();
</script>

{% schema %}
  {
    "name": "Real results videos",
    "class": "custom-product-stack-section",
    "settings": [
      {
        "type": "text",
        "id": "rating_text",
        "label": "Rating text",
        "default": "5.0/5.0"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Real Routines. Real Results."
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "Text",
        "default": "<p>See how Slimfair Coffee fits into busy mornings, self-care moments and healthy lifestyles supporting weight, digestion, energy and glow.</p>"
      },
      {
        "type": "header",
        "content": "Colors"
      }, {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#F5FCE9"
      }, {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#5C3F2D"
      }, {
        "type": "color",
        "id": "text_color",
        "label": "Text color",
        "default": "#6D563D"
      }, {
        "type": "color",
        "id": "accent_color",
        "label": "Star color",
        "default": "#C48645"
      }, {
        "type": "color",
        "id": "line_color",
        "label": "Control line color",
        "default": "#8F5F2E"
      }, {
        "type": "header",
        "content": "Spacing"
      }, {
        "type": "range",
        "id": "padding_top",
        "label": "Top padding",
        "min": 24,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 24
      }, {
        "type": "range",
        "id": "padding_bottom",
        "label": "Bottom padding",
        "min": 24,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 44
      }
    ],
    "blocks": [
      {
        "type": "video_card",
        "name": "Video card",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Thumbnail image"
          },
          {
            "type": "video",
            "id": "hosted_video",
            "label": "Hosted video"
          },
          {
            "type": "url",
            "id": "video_url",
            "label": "Video link"
          },
          {
            "type": "textarea",
            "id": "overlay_quote",
            "label": "Overlay quote"
          }, {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Lorem ipsum dolor sit amet!"
          }, {
            "type": "richtext",
            "id": "quote",
            "label": "Quote",
            "default": "<p>\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor\"</p>"
          }, {
            "type": "text",
            "id": "name",
            "label": "Name",
            "default": "Jane Doe"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Real results videos",
        "category": "Custom",
        "blocks": [
          {
            "type": "video_card"
          },
          {
            "type": "video_card"
          },
          {
            "type": "video_card"
          },
          {
            "type": "video_card"
          }, {
            "type": "video_card"
          }
        ]
      }
    ]
  }
{% endschema %}
